use Libraries.Game.Game
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Compute.Vector3
use Libraries.Compute.Random
use Libraries.Interface.Item3D
use Libraries.Game.Physics.Vehicles.Vehicle
use Libraries.Game.Physics.Vehicles.Suspension
use Libraries.Game.Physics.PhysicsProperties3D
use Libraries.Interface.Behaviors.Games.VehicleMovementBehavior

/*
    A small Bullet-style forklift. Arrow keys steer and drive; Shift+Left/Right
    tilt the mast, and Shift+Up/Down raise and lower the fork carriage.
*/
class Main is Game
    Model ground
    Model chassis
    Model load
    Model leftWheel
    Model rightWheel
    Model rearLeftWheel
    Model rearRightWheel
    Vehicle vehicle
    VehicleMovementBehavior movement
    PhysicsProperties3D stackProperties
    Camera camera = undefined
    
    integer numBoxesY = 12
    integer numBoxesX = 10
    integer numBoxesZ = 3
    Color color

    action Main
        //UseVulkan(true)
        StartGame()
    end

    action CreateGame
        EnablePhysics3D(true)
        SetGravity3D(0, -9.8, 0)
        Color colors

        DirectionalLight sunlight
        sunlight:SetIntensity(2.5)
        sunlight:SetColor(colors:LightGray())
        sunlight:SetDirection(-1, -4, 2)
        Add(sunlight)

        BuildGround(colors)
        BuildChassis(colors)
        BuildWheels(colors)
        BuildVehicle()
        BuildStack()
    end

    action BuildGround(Color colors)
        ground:LoadBox(80, 1, 80, colors:Gray())
        ground:SetPosition(0, -0.5, 0)
        ground:EnablePhysics(true)
        ground:SetMass(0)
        ground:SetFriction(1)
        ground:SetName("Ground")
        Add(ground)
    end
    
    action BuildStack
        stackProperties:SetResponsiveness(stackProperties:RESPONSIVE)
        stackProperties:SetFriction(0.5)
        stackProperties:SetRestitution(0.5)
        number xstart = -2
        number ystart = 0.75
        number zstart = 15
        Random random
        
        i = 0
        j = 0
        k = 0
        repeat while i < numBoxesY
            repeat while j < numBoxesX
                repeat while k < numBoxesZ
                    Model box
                box:LoadBox(0.5, 0.5, 0.5, color:CustomColor(random:RandomNumber(), random:RandomNumber(), random:RandomNumber(), 1))
                box:SetPosition(xstart + (j * 0.5), ystart + (i * 0.5), zstart + (-k * 0.5))
                box:EnablePhysics(true)
                box:SetPhysicsProperties(stackProperties)
                
                Add(box)
                    
                    k = k + 1
                end
                
                k = 0
                j = j + 1
            end
            
            j = 0
            i = i + 1
        end
    end

    action BuildChassis(Color colors)
        chassis:LoadBox(2, 1, 4, colors:Green())
        chassis:EnablePhysics(true)
        chassis:RequireSimulation(true)
        chassis:SetResponsive()
        chassis:SetMass(800)
        chassis:SetFriction(0.6)
        chassis:SetRestitution(0)
        chassis:SetLinearDamping(0.05)
        chassis:SetAngularDamping(0.8)
        chassis:SetPosition(0, 1.3, 0)
        chassis:SetName("Forklift Chassis")
        Add(chassis)
    end

    action BuildWheels(Color colors)
        BuildWheel(leftWheel, colors, -0.88, 1.5)
        BuildWheel(rightWheel, colors, 0.88, 1.5)
        BuildWheel(rearLeftWheel, colors, -0.88, -1.5)
        BuildWheel(rearRightWheel, colors, 0.88, -1.5)
    end

    action BuildWheel(Model wheel, Color colors, number x, number z)
        // A low-division cylinder (diameter 1 = 2 * wheel radius) with a
        // contrasting spoke, so spin and steering are visible. The cylinder's
        // axis starts along Y and is rotated onto X to line up with the axle.
        wheel:LoadCylinder(1, 0.4, 1, 8, colors:Blue())
        Model spoke
        spoke:LoadBox(0.9, 0.44, 0.15, colors:Red())
        wheel:Add(spoke)
        wheel:Rotate(0, 0, 1, 90)
        wheel:SetPosition(x, 0.5, z)
        wheel:SetName("Raycast Wheel")
        Add(wheel)
    end

    action BuildVehicle
        vehicle:SetChassis(chassis)
        // Hard points positioned so suspension starts at rest length (uncompressed)
        // Chassis at Y=1.3, ground at Y=0, wheel radius 0.5, rest length 1.3
        // For zero compression: hard point Y = ground + wheelRadius + restLength = 0 + 0.5 + 1.3 = 1.8
        // So offset from chassis = 1.8 - 1.3 = 0.5
        vehicle:Add(AddWheel(leftWheel, MakeVector(-0.88, 0.5, 1.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, true))
        vehicle:Add(AddWheel(rightWheel, MakeVector(0.88, 0.5, 1.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, true))
        vehicle:Add(AddWheel(rearLeftWheel, MakeVector(-0.88, 0.5, -2.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, false))
        vehicle:Add(AddWheel(rearRightWheel, MakeVector(0.88, 0.5, -2.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, false))
        GetCurrentLayer3D():Add(vehicle)

        // The movement behavior drives the vehicle from the arrow keys, with the
        // space bar as the brake. As a behavior of the chassis, it is updated
        // every frame before the physics runs.
        movement:SetVehicle(vehicle)
        movement:SetEngineForce(4200)
        movement:SetReverseForce(2800)
        movement:SetMaximumSteering(0.45)
        movement:AddDriveWheel(0)
        movement:AddDriveWheel(1)
        chassis:AddBehavior(movement)
    end
    
    
    action AddWheel(Item3D visual, Vector3 connection, Vector3 direction, Vector3 axle, number restLength, number radius, boolean frontWheel) returns Suspension
        Suspension wheel
        wheel:SetVisual(visual)
        wheel:SetConnectionPoint(connection)
        wheel:SetDirection(direction)
        wheel:SetAxle(axle)
        wheel:SetRestLength(restLength)
        wheel:SetRadius(radius)
        wheel:SetSteeringEnabled(frontWheel)
        // Tuned for this forklift. These are stiffer and grippier than
        // Suspension's defaults, which match Bullet's btVehicleTuning.
        wheel:SetSuspensionStiffness(25)
        wheel:SetDampingCompression(2.5)
        wheel:SetDampingRelaxation(2.0)
        wheel:SetFrictionSlip(100)
        return wheel
    end

    action MakeVector(number x, number y, number z) returns Vector3
        Vector3 result
        result:Set(x, y, z)
        return result
    end
end
