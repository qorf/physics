use Libraries.Game.Game
use Libraries.Game.Layer3D
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Game.Graphics.PointLight
use Libraries.Game.InputMonitor
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Game.Physics.Vehicle
use Libraries.Game.Physics.Suspension
use Libraries.Game.Physics.Joints.HingeJoint3D
use Libraries.Game.Physics.Joints.SliderJoint3D
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Compute.Vector3
use Libraries.Compute.Matrix3

/*
    A small Bullet-style forklift. Arrow keys steer and drive; Shift+Left/Right
    tilt the mast, and Shift+Up/Down raise and lower the fork carriage.
*/
class Main is Game
    Model ground
    Model chassis
    Model mast
    Model forks
    Model leftProng
    Model rightProng
    Model load
    Model leftWheel
    Model rightWheel
    Model rearLeftWheel
    Model rearRightWheel
    Vehicle vehicle
    InputMonitor monitor
    KeyboardEvent keys

    action Main
        UseVulkan(true)
        StartGame()
    end

    action CreateGame
        EnablePhysics3D(true)
        SetGravity3D(0, -9.8, 0)
        Color colors


        DirectionalLight sunlight
        sunlight:SetIntensity(2.5)
        sunlight:SetColor(colors:LightGray())
        sunlight:SetDirection(-1, -4, -2)
        Add(sunlight)

        PointLight workLight
        workLight:SetPosition(3, 5, 1)
        workLight:SetIntensity(18)
        workLight:SetColor(colors:White())
        Add(workLight)

        BuildGround(colors)
        BuildChassis(colors)
        BuildWheels(colors)
        BuildVehicle()
    end

    action BuildGround(Color colors)
        ground:LoadBox(80, 1, 80, colors:Gray())
        ground:SetPosition(0, -0.5, 0)
        ground:EnablePhysics(true)
        ground:SetMass(0)
        ground:SetFriction(1)
        ground:SetName("Ground")
        Add(ground)
    end

    action BuildChassis(Color colors)
        chassis:LoadBox(2, 1, 4, colors:Yellow())
        chassis:EnablePhysics(true)
        chassis:RequireSimulation(true)
        chassis:SetResponsive()
        chassis:SetMass(800)
        chassis:SetFriction(0.6)
        chassis:SetRestitution(0)
        chassis:SetLinearDamping(0.05)
        chassis:SetAngularDamping(0.8)
        chassis:SetPosition(0, 1.3, 0)
        chassis:SetName("Forklift Chassis")
        Add(chassis)
    end

    action BuildWheels(Color colors)
        BuildWheel(leftWheel, colors, -0.88, 1.5)
        BuildWheel(rightWheel, colors, 0.88, 1.5)
        BuildWheel(rearLeftWheel, colors, -0.88, -1.5)
        BuildWheel(rearRightWheel, colors, 0.88, -1.5)
    end

    action BuildWheel(Model wheel, Color colors, number x, number z)
        wheel:LoadSphere(0.5, 0.5, 0.5, colors:Black())
        wheel:SetPosition(x, 0.5, z)
        //wheel:EnablePhysics(true)
        //wheel:SetResponsive()
        //wheel:SetMass(20)
        //wheel:SetFriction(1.0)
        //wheel:SetRestitution(0.1)
        wheel:SetName("Raycast Wheel")
        Add(wheel)
    end

    action BuildMastAndForks(Color colors)
        // Lift body: thin vertical bar that hinges to the chassis
        mast:LoadBox(1, 4, 0.1, colors:DarkGray())
        mast:EnablePhysics(true)
        mast:RequireSimulation(true)
        mast:SetResponsive()
        mast:SetMass(10)
        mast:SetFriction(0.5)
        mast:SetRestitution(0)
        mast:SetPosition(0, 2.5, 3.05)
        mast:SetName("Lift Body")
        Add(mast)

        // Fork carriage: main bar with two prongs that slide along the mast
        forks:LoadBox(2, 0.2, 0.2, colors:DarkGray())
        forks:EnablePhysics(true)
        forks:RequireSimulation(true)
        forks:SetResponsive()
        forks:SetMass(5)
        forks:SetFriction(0.9)
        forks:SetRestitution(0)
        forks:SetPosition(0, 0.6, 3.2)
        forks:SetName("Fork Carriage")
        Add(forks)

        // Left fork prong (visual only, physics handled by carriage)
        leftProng:LoadBox(0.2, 0.04, 1.2, colors:DarkGray())
        leftProng:SetPosition(-0.9, 0.52, 3.9)
        leftProng:SetName("Left Prong")
        Add(leftProng)

        // Right fork prong (visual only, physics handled by carriage)
        rightProng:LoadBox(0.2, 0.04, 1.2, colors:DarkGray())
        rightProng:SetPosition(0.9, 0.52, 3.9)
        rightProng:SetName("Right Prong")
        Add(rightProng)

        // Load: pallet with side supports
        Model cargo
        cargo:LoadBox(4, 1, 1, colors:Blue())
        cargo:EnablePhysics(true)
        cargo:RequireSimulation(true)
        cargo:SetResponsive()
        cargo:SetMass(350)
        cargo:SetFriction(0.8)
        cargo:SetRestitution(0)
        cargo:SetPosition(0, 3.5, 7.0)
        cargo:SetName("Load")
        load = cargo
        Add(load)
    end

    action BuildVehicle
        vehicle:Initialize(GetCurrentLayer3D(), chassis)
        vehicle:SetMaxLateralImpulse(12)
        // Hard points positioned so suspension starts at rest length (uncompressed)
        // Chassis at Y=1.3, ground at Y=0, wheel radius 0.5, rest length 1.3
        // For zero compression: hard point Y = ground + wheelRadius + restLength = 0 + 0.5 + 1.3 = 1.8
        // So offset from chassis = 1.8 - 1.3 = 0.5
        vehicle:AddWheel(leftWheel, MakeVector(-0.88, 0.5, 1.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, true)
        vehicle:AddWheel(rightWheel, MakeVector(0.88, 0.5, 1.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, true)
        vehicle:AddWheel(rearLeftWheel, MakeVector(-0.88, 0.5, -2.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, false)
        vehicle:AddWheel(rearRightWheel, MakeVector(0.88, 0.5, -2.5), MakeVector(0, -1, 0), MakeVector(1, 0, 0), 1.3, 0.5, false)
    end


    action MakeVector(number x, number y, number z) returns Vector3
        Vector3 result
        result:Set(x, y, z)
        return result
    end

    number actualTime = 0
    action Update(number seconds)
        actualTime = actualTime + seconds
vehicle:Update(seconds)
        DriveAndOperate()
    end

    action DriveAndOperate
        boolean shifting = monitor:IsKeyPressed(keys:SHIFT_LEFT) or monitor:IsKeyPressed(keys:SHIFT_RIGHT)
        if shifting
            number mastSpeed = 0
            if monitor:IsKeyPressed(keys:LEFT)
                mastSpeed = 0.7
            elseif monitor:IsKeyPressed(keys:RIGHT)
                mastSpeed = -0.7
            end

            number liftSpeed = 0
            if monitor:IsKeyPressed(keys:UP)
                liftSpeed = 1.0
            elseif monitor:IsKeyPressed(keys:DOWN)
                liftSpeed = -1.0
            end

            vehicle:ApplyEngineForce(0, 0)
            vehicle:ApplyEngineForce(0, 1)
            vehicle:ApplyEngineForce(0, 2)
            vehicle:ApplyEngineForce(0, 3)
            vehicle:SetSteeringValue(0, 0)
            vehicle:SetSteeringValue(0, 1)
        else

            number throttle = 0
            boolean isDriving = false
            if monitor:IsKeyPressed(keys:UP)
                throttle = 42000
                isDriving = true
            elseif monitor:IsKeyPressed(keys:DOWN)
                throttle = -2800
                isDriving = true
            end
            vehicle:ApplyEngineForce(throttle, 0)
            vehicle:ApplyEngineForce(throttle, 1)
            vehicle:ApplyEngineForce(0, 2)
            vehicle:ApplyEngineForce(0, 3)

            if isDriving
                // output "Applying throttle 420, chassis Y = " + chassis:GetY()
                output "[DRIVE] Pos: (" + chassis:GetX() + ", " + chassis:GetY() + ", " + chassis:GetZ() + ")"
                output "[DRIVE ROTATION] RotX: " + chassis:GetPitch() + ", RotY: " + chassis:GetRoll() + ", RotZ: " + chassis:GetYaw()
            end

            number steering = 0
            if monitor:IsKeyPressed(keys:LEFT)
                steering = 0.45
            elseif monitor:IsKeyPressed(keys:RIGHT)
                steering = -0.45
            end
            vehicle:SetSteeringValue(steering, 0)
            vehicle:SetSteeringValue(steering, 1)
            vehicle:SetSteeringValue(0, 2)
            vehicle:SetSteeringValue(0, 3)
        end
    end
end
