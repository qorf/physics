package Libraries.Game.Physics

use Libraries.Game.Layer3D
use Libraries.Interface.Item3D
use Libraries.Containers.Array
use Libraries.Compute.Vector3
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Compute.Math
use Libraries.Compute.Matrix3

/*
    Raycast vehicle modeled on Bullet's btRaycastVehicle. Each wheel casts a
    suspension ray; chassis impulses provide spring response, and contact point
    impulses provide steering, engine drive, braking, and tire friction.
    Axes follow Bullet's default convention: X right, Y up, Z forward.
*/
class Vehicle
    Math math
    public Layer3D world = undefined
    public Item3D chassis
    public Array<Suspension> wheels
    public number maxSuspensionTravel = 2.0
    public number steeringClamp = 0.30
    public number currentSpeedKPH = 0
    PhysicsRaycast raycast

    action Initialize(Layer3D layer, Item3D vehicleChassis)
        world = layer
        chassis = vehicleChassis
        PhysicsRaycast temp
        raycast = temp
    end

    action AddWheel(Item3D visual, Vector3 connection, Vector3 direction, Vector3 axle, number restLength, number radius, boolean frontWheel) returns Suspension
        if wheels = undefined
            Array<Suspension> temp
            wheels = temp
        end
        Suspension wheel
        wheel:SetVisual(visual)
        wheel:SetConnectionPoint(connection)
        wheel:SetDirection(direction)
        wheel:SetAxle(axle)
        wheel:SetRestLength(restLength)
        wheel:SetRadius(radius)
        wheel:SetSteeringEnabled(frontWheel)
        
        
        //wheel:Initialize(visual, connection, direction, axle, restLength, radius, frontWheel)
        wheels:Add(wheel)
        return wheel
    end

    action SetSteeringValue(number value, integer wheelIndex)
        Suspension wheel = wheels:Get(wheelIndex)
        wheel:steering = Clamp(value, -steeringClamp, steeringClamp)
    end

    action ApplyEngineForce(number force, integer wheelIndex)
     Suspension wheel = wheels:Get(wheelIndex)
        wheel:engineForce = force
    end

    action SetBrake(number force, integer wheelIndex)
        Suspension wheel = wheels:Get(wheelIndex)
        wheel:brake = math:MaximumOf(0, force)
    end

    action GetSpeedKPH returns number
        return currentSpeedKPH
    end

    /* Call once per physics update, using the same elapsed seconds as the world. */
    action Update(number timeStep)
if timeStep <= 0 or chassis = undefined
            return now
        end

        currentSpeedKPH = chassis:GetLinearVelocity():Length() * 3.6
        Vector3 angularBeforeUpdate
        angularBeforeUpdate:Set(chassis:GetAngularVelocity())
        integer i = 0
        repeat while i < wheels:GetSize()
            UpdateWheel(wheels:Get(i), timeStep, i)
            i = i + 1
        end

        ApplySuspensionImpulses()
        Vector3 angularAfterSuspension
        angularAfterSuspension:Set(chassis:GetAngularVelocity())
        CalculateTireImpulses(timeStep)

        // Apply all accumulated impulses after all wheels have been calculated
        i = 0
        repeat while i < wheels:GetSize()
            ApplyStoredImpulses(wheels:Get(i), i)
            i = i + 1
        end

        Vector3 angVel = chassis:GetAngularVelocity()
        //output "[VEHICLE-ANGULAR-BUDGET] before=(" + angularBeforeUpdate:GetX() + "," + angularBeforeUpdate:GetY() + "," + angularBeforeUpdate:GetZ() + ") afterSuspension=(" + angularAfterSuspension:GetX() + "," + angularAfterSuspension:GetY() + "," + angularAfterSuspension:GetZ() + ") afterTires=(" + angVel:GetX() + "," + angVel:GetY() + "," + angVel:GetZ() + ")"
        //output "[CHASSIS] angularVel=(" + angVel:GetX() + "," + angVel:GetY() + "," + angVel:GetZ() + ")"
    end

    private action ApplySuspensionImpulses()
        integer i = 0
        repeat while i < wheels:GetSize()
            Suspension wheel = wheels:Get(i)
            if wheel:inContact
                // Bullet applies suspension impulses to the chassis before tire friction.
                Vector3 torque
                torque:Set(wheel:suspensionChassisPoint)
                torque:CrossProduct(wheel:suspensionImpulse)
                Vector3 before
                before:Set(chassis:GetAngularVelocity())
                chassis:ApplyImpulse(wheel:suspensionImpulse, wheel:suspensionChassisPoint)
                Vector3 after = chassis:GetAngularVelocity()
                //output "[SUSPENSION-TORQUE] wheelIndex=" + i + " front=" + wheel:frontWheel + " force=" + wheel:suspensionForce + " length=" + wheel:suspensionLength + " point=(" + wheel:suspensionChassisPoint:GetX() + "," + wheel:suspensionChassisPoint:GetY() + "," + wheel:suspensionChassisPoint:GetZ() + ") impulse=(" + wheel:suspensionImpulse:GetX() + "," + wheel:suspensionImpulse:GetY() + "," + wheel:suspensionImpulse:GetZ() + ") torque=(" + torque:GetX() + "," + torque:GetY() + "," + torque:GetZ() + ") deltaAngularVelocity=(" + (after:GetX() - before:GetX()) + "," + (after:GetY() - before:GetY()) + "," + (after:GetZ() - before:GetZ()) + ")"
            end
            i = i + 1
        end
    end

    // Bullet transforms chassis-space vectors as basis * vector. Keep this local to the vehicle.
    private action TransformByChassisBasis(Vector3 vector, Matrix3 basis)
        number x = vector:GetX()
        number y = vector:GetY()
        number z = vector:GetZ()
        vector:Set(basis:row0column0 * x + basis:row0column1 * y + basis:row0column2 * z, basis:row1column0 * x + basis:row1column1 * y + basis:row1column2 * z, basis:row2column0 * x + basis:row2column1 * y + basis:row2column2 * z)
    end

    private action UpdateWheel(Suspension wheel, number timeStep, integer wheelIndex)
        Vector3 chassisPos
        chassisPos:Set(chassis:GetX(), chassis:GetY(), chassis:GetZ())

        // Get chassis rotation and apply it to the connection point offset
        Matrix3 chassisRotation = chassis:GetCenterOfMassTransform():GetBasis()
        Vector3 rotatedOffset
        rotatedOffset:Set(wheel:GetConnectionPoint())
        TransformByChassisBasis(rotatedOffset, chassisRotation)

        // Calculate hard point in world space: chassis position + rotated offset
        Vector3 suspensionOriginWorldSpace = wheel:GetSuspensionOriginWorldSpace()
        suspensionOriginWorldSpace:Set(chassisPos)
        suspensionOriginWorldSpace:Add(rotatedOffset)

        // Transform suspension direction from chassis-space to world-space
        Vector3 directionWorldSpace = wheel:GetDirectionWorldSpace()
        directionWorldSpace:Set(wheel:GetDirection())
        TransformByChassisBasis(directionWorldSpace, chassisRotation)
        directionWorldSpace:Normalize()

        // Apply steering to axle in car space, then rotate to world space
        Vector3 axleWorldSpace = wheel:GetAxleWorldSpace()
        axleWorldSpace:Set(wheel:GetAxle())
        if wheel:IsSteeringEnabled()
            number cosine = math:Cosine(wheel:steering)
            number sine = math:Sine(wheel:steering)
            Vector3 axleCS = wheel:GetAxle()
            // Rotation around Y axis (vertical in Quorum's Y-up): rotate in XZ plane
            axleWorldSpace:Set(cosine * axleCS:GetX() - sine * axleCS:GetZ(), axleCS:GetY(), sine * axleCS:GetX() + cosine * axleCS:GetZ())
        end

        // Rotate axle by chassis rotation to get world space
        TransformByChassisBasis(axleWorldSpace, chassisRotation)
        axleWorldSpace:Normalize()

        number rayLength = wheel:GetRestLength() + wheel:GetRadius() + maxSuspensionTravel
        Vector3 rayEnd
        rayEnd:Set(directionWorldSpace)
        rayEnd:Scale(rayLength)
        rayEnd:Add(suspensionOriginWorldSpace)

        // Sanity check: hard point should be near chassis (within reasonable bounds)
        number hardPointY = suspensionOriginWorldSpace:GetY()
        boolean hardPointValid = hardPointY > -1000 and hardPointY < 1000

        boolean hitDetected = false
        if raycast not= undefined and hardPointValid
            raycast:Cast(world, suspensionOriginWorldSpace, rayEnd, chassis)
            hitDetected = raycast:hit
        elseif not hardPointValid
            //output "WARNING: Invalid hard point Y = " + hardPointY + " (chassis Y = " + chassis:GetY() + ")"
        end

        wheel:inContact = hitDetected
        wheel:suspensionForce = 0
        wheel:groundBody = undefined

        if hitDetected
            wheel:groundBody = raycast:hitBody
            Vector3 contactPointWorldSpace = wheel:GetContactPointWorldSpace()
            Vector3 contactNormalWorldSpace = wheel:GetContactNormalWorldSpace()
            contactPointWorldSpace:Set(raycast:hitPoint)
            contactNormalWorldSpace:Set(raycast:hitNormal)
            number hitDistance = rayLength * raycast:fraction
            wheel:SetSuspensionLength(Clamp(hitDistance - wheel:GetRadius(), wheel:GetRestLength() - maxSuspensionTravel, wheel:GetRestLength() + maxSuspensionTravel))

            Vector3 chassisRelativePoint
            chassisRelativePoint:Set(contactPointWorldSpace)
            chassisRelativePoint:Subtract(chassis:GetCenterOfMassTransform():GetOrigin())
            Vector3 chassisVelocity = chassis:GetLinearVelocityAtLocalPoint(chassisRelativePoint)
            //output "[DEBUG-VELOCITY] wheel=" + wheel:wheelVisual:GetName() + " chassisVelocity=(" + chassisVelocity:GetX() + "," + chassisVelocity:GetY() + "," + chassisVelocity:GetZ() + ") angularVelocity=(" + chassis:GetAngularVelocity():GetX() + "," + chassis:GetAngularVelocity():GetY() + "," + chassis:GetAngularVelocity():GetZ() + ")"
            Vector3 relativeVelocity
            relativeVelocity:Set(chassisVelocity)
            Vector3 groundRelativePoint
            if wheel:groundBody not= undefined
                groundRelativePoint:Set(contactPointWorldSpace)
                groundRelativePoint:Subtract(wheel:groundBody:GetCenterOfMassTransform():GetOrigin())
                relativeVelocity:Subtract(wheel:groundBody:GetLinearVelocityAtLocalPoint(groundRelativePoint))
            end

            number normalSpeed = relativeVelocity:DotProduct(contactNormalWorldSpace)
            //output "[WHEEL-VELOCITY] name=" + wheel:wheelVisual:GetName() + " normalSpeed=" + normalSpeed + " relativeVelocity=(" + relativeVelocity:GetX() + "," + relativeVelocity:GetY() + "," + relativeVelocity:GetZ() + ") contactNormal=(" + wheel:contactNormalWS:GetX() + "," + wheel:contactNormalWS:GetY() + "," + wheel:contactNormalWS:GetZ() + ")"
            number compression = wheel:GetRestLength() - wheel:GetSuspensionLength()
            number damping = wheel:dampingRelaxation
            if normalSpeed < 0
                damping = wheel:GetDampingCompression()
            end
            // Bullet scales its spring and damping response by the chassis mass.
            wheel:suspensionForce = (wheel:GetSuspensionStiffness() * compression - damping * normalSpeed) * chassis:GetMass()
            wheel:suspensionForce = Clamp(wheel:suspensionForce, 0, wheel:maxSuspensionForce)

            //output "[SUSPENSION-STATE] wheelIndex=" + wheelIndex + " front=" + wheel:frontWheel + " contact=" + hitDetected + " compression=" + compression + " suspensionLength=" + wheel:suspensionLength + " normalSpeed=" + normalSpeed + " force=" + wheel:suspensionForce + " pointWS=(" + wheel:contactPointWS:GetX() + "," + wheel:contactPointWS:GetY() + "," + wheel:contactPointWS:GetZ() + ") normalWS=(" + wheel:contactNormalWS:GetX() + "," + wheel:contactNormalWS:GetY() + "," + wheel:contactNormalWS:GetZ() + ")"

            //output "[WHEEL] name=" + wheel:wheelVisual:GetName() + " compression=" + compression + " suspensionForce=" + wheel:suspensionForce + " contactNormal=(" + wheel:contactNormalWS:GetX() + "," + wheel:contactNormalWS:GetY() + "," + wheel:contactNormalWS:GetZ() + ") hardPointWS=(" + wheel:hardPointWS:GetX() + "," + wheel:hardPointWS:GetY() + "," + wheel:hardPointWS:GetZ() + ")"

            // Store suspension impulse for deferred application
            wheel:suspensionImpulse:Set(contactNormalWorldSpace)
            wheel:suspensionImpulse:Scale(wheel:suspensionForce * timeStep)
            wheel:suspensionChassisPoint:Set(chassisRelativePoint)
            wheel:suspensionGroundPoint:Set(groundRelativePoint)

        else
            wheel:SetSuspensionLength(wheel:GetRestLength() + maxSuspensionTravel)
        end

        if wheel:GetVisual() not= undefined
            Item3D visual = wheel:GetVisual()
            Vector3 wheelPosition
            wheelPosition:Set(directionWorldSpace)
            wheelPosition:Scale(wheel:GetSuspensionLength())
            wheelPosition:Add(suspensionOriginWorldSpace)

            // Safety check: don't set wheel to invalid positions
            if wheelPosition:GetY() > -1000 and wheelPosition:GetY() < 1000
                visual:SetPosition(wheelPosition)
            end
        end
    end

    private action CalculateTireImpulses(number timeStep)
        integer groundedWheels = 0
        integer i = 0
        repeat while i < wheels:GetSize()
            Suspension wheel = wheels:Get(i)
            wheel:tireImpulse:Set(0, 0, 0)
            wheel:tireForwardImpulse:Set(0, 0, 0)
            wheel:tireSideImpulse:Set(0, 0, 0)
            if wheel:inContact and wheel:groundBody not= undefined
                groundedWheels = groundedWheels + 1
            end
            i = i + 1
        end

        if groundedWheels = 0
            return now
        end

        boolean sliding = false
        Array<number> skidInfo
        Array<number> sideValues
        Array<number> forwardValues
        i = 0
        repeat while i < wheels:GetSize()
            skidInfo:Add(1.0)
            sideValues:Add(0.0)
            forwardValues:Add(0.0)
            Suspension wheel = wheels:Get(i)
            if wheel:inContact and wheel:groundBody not= undefined
                Vector3 axle
                
                Vector3 axleWorldSpace = wheel:GetAxleWorldSpace()
                Vector3 contactNormalWorldSpace = wheel:GetContactNormalWorldSpace()
                axle:Set(axleWorldSpace)
                // Main supplies +X axles, while Bullet's ForkLift uses -X.
                // Keep that port convention when building Bullet's wheel basis.
                axle:MakeOpposite()
                number axleNormal = axle:DotProduct(contactNormalWorldSpace)
                Vector3 normalPart
                normalPart:Set(contactNormalWorldSpace):Scale(axleNormal)
                axle:Subtract(normalPart)
                axle:Normalize()

                Vector3 forward
                forward:Set(contactNormalWorldSpace)
                forward:CrossProduct(axle)
                forward:Normalize()

                Vector3 chassisPoint
                Vector3 contactPointWorldSpace = wheel:GetContactPointWorldSpace()
                chassisPoint:Set(contactPointWorldSpace)
                chassisPoint:Subtract(chassis:GetCenterOfMassTransform():GetOrigin())
                Vector3 relativeVelocity = chassis:GetLinearVelocityAtLocalPoint(chassisPoint)
                Vector3 groundPoint
                groundPoint:Set(contactPointWorldSpace)
                groundPoint:Subtract(wheel:groundBody:GetCenterOfMassTransform():GetOrigin())
                relativeVelocity:Subtract(wheel:groundBody:GetLinearVelocityAtLocalPoint(groundPoint))

                number lateralVelocity = relativeVelocity:DotProduct(axle)
                number forwardVelocity = relativeVelocity:DotProduct(forward)
                number sideDenominator = chassis:ComputeImpulseDenominator(contactPointWorldSpace, axle) + wheel:groundBody:ComputeImpulseDenominator(contactPointWorldSpace, axle)
                number sideImpulse = 0
                if sideDenominator > 0.000001
                    sideImpulse = -lateralVelocity / sideDenominator / groundedWheels
                end

                number forwardDenominator = chassis:ComputeImpulseDenominator(contactPointWorldSpace, forward) + wheel:groundBody:ComputeImpulseDenominator(contactPointWorldSpace, forward)
                number forwardImpulse = 0
                if wheel:engineForce not= 0
                    forwardImpulse = wheel:engineForce * timeStep
                elseif forwardDenominator > 0.000001 and wheel:brake > 0
                    forwardImpulse = -forwardVelocity / forwardDenominator / groundedWheels
                    forwardImpulse = Clamp(forwardImpulse, -wheel:brake, wheel:brake)
                end

                //output "[TIRE-SOLVE] wheelIndex=" + i + " front=" + wheel:frontWheel + " steering=" + wheel:steering + " contactPoint=(" + wheel:contactPointWS:GetX() + "," + wheel:contactPointWS:GetY() + "," + wheel:contactPointWS:GetZ() + ") relativeVelocity=(" + relativeVelocity:GetX() + "," + relativeVelocity:GetY() + "," + relativeVelocity:GetZ() + ") axle=(" + axle:GetX() + "," + axle:GetY() + "," + axle:GetZ() + ") forward=(" + forward:GetX() + "," + forward:GetY() + "," + forward:GetZ() + ") lateralSpeed=" + lateralVelocity + " forwardSpeed=" + forwardVelocity + " sideDenominator=" + sideDenominator + " forwardDenominator=" + forwardDenominator + " rawSideImpulse=" + sideImpulse + " rawForwardImpulse=" + forwardImpulse

                // Bullet weights forward traction by 0.5 and side traction by 1.0.
                number maxImpulse = wheel:frictionSlip * wheel:suspensionForce * timeStep
                number weightedForward = forwardImpulse * 0.5
                number impulseLength = math:SquareRoot(weightedForward * weightedForward + sideImpulse * sideImpulse)
                number wheelSkid = 1.0
                if impulseLength > maxImpulse and impulseLength > 0
                    wheelSkid = maxImpulse / impulseLength
                    sliding = true
                end
                skidInfo:Set(i, wheelSkid)
                sideValues:Set(i, sideImpulse)
                forwardValues:Set(i, forwardImpulse)
            end
            i = i + 1
        end

        i = 0
        repeat while i < wheels:GetSize()
            Suspension wheel = wheels:Get(i)
            if wheel:inContact and wheel:groundBody not= undefined
                number skid = skidInfo:Get(i)
                number sideImpulse = sideValues:Get(i)
                number forwardImpulse = forwardValues:Get(i)
                // Match Bullet: only scale a wheel's impulses when the vehicle is
                // sliding and that wheel has a nonzero side-friction impulse.
                if sliding and sideImpulse not= 0 and skid < 1
                    sideImpulse = sideImpulse * skid
                    forwardImpulse = forwardImpulse * skid
                end

                Vector3 axle
                Vector3 axleWorldSpace = wheel:GetAxleWorldSpace()
                Vector3 contactPointWorldSpace = wheel:GetContactPointWorldSpace()
                Vector3 contactNormalWorldSpace = wheel:GetContactNormalWorldSpace()
                axle:Set(axleWorldSpace)
                axle:MakeOpposite()
                number axleNormal = axle:DotProduct(contactNormalWorldSpace)
                Vector3 normalPart
                normalPart:Set(contactNormalWorldSpace):Scale(axleNormal)
                axle:Subtract(normalPart)
                axle:Normalize()
                Vector3 forward
                forward:Set(contactNormalWorldSpace)
                forward:CrossProduct(axle)
                forward:Normalize()

                wheel:tireSideImpulse:Set(axle):Scale(sideImpulse)
                wheel:tireForwardImpulse:Set(forward):Scale(forwardImpulse)
                wheel:tireImpulse:Set(wheel:tireSideImpulse):Add(wheel:tireForwardImpulse)
                wheel:tireChassisPoint:Set(contactPointWorldSpace)
                wheel:tireChassisPoint:Subtract(chassis:GetCenterOfMassTransform():GetOrigin())
                wheel:tireGroundPoint:Set(contactPointWorldSpace)
                wheel:tireGroundPoint:Subtract(wheel:groundBody:GetCenterOfMassTransform():GetOrigin())
                //output "[TIRE-BULLET] wheelIndex=" + i + " front=" + wheel:frontWheel + " steering=" + wheel:steering + " engineForce=" + wheel:engineForce + " sideImpulse=" + sideImpulse + " forwardImpulse=" + forwardImpulse + " skidInfo=" + skid + " tireImpulse=(" + wheel:tireImpulse:GetX() + "," + wheel:tireImpulse:GetY() + "," + wheel:tireImpulse:GetZ() + ") point=(" + wheel:tireChassisPoint:GetX() + "," + wheel:tireChassisPoint:GetY() + "," + wheel:tireChassisPoint:GetZ() + ")"
            end
            i = i + 1
        end
    end

    private action ApplyStoredImpulses(Suspension wheel, integer wheelIndex)
        if wheel:inContact
            // Bullet applies forward tire impulse to the chassis only. Side
            // friction is applied to both bodies and uses rollInfluence on the chassis.
            Vector3 angularBefore
            angularBefore:Set(chassis:GetAngularVelocity())
            Vector3 forwardTorque
            forwardTorque:Set(wheel:tireChassisPoint)
            forwardTorque:CrossProduct(wheel:tireForwardImpulse)
            if not wheel:tireForwardImpulse:IsZero(0.000000119209290)
                chassis:ApplyImpulse(wheel:tireForwardImpulse, wheel:tireChassisPoint)
            end
            Vector3 sidePoint
            Vector3 sideTorque
            if not wheel:tireSideImpulse:IsZero(0.000000119209290)
                sidePoint:Set(wheel:tireChassisPoint)
                sidePoint:Set(sidePoint:GetX(), sidePoint:GetY() * wheel:rollInfluence, sidePoint:GetZ())
                sideTorque:Set(sidePoint)
                sideTorque:CrossProduct(wheel:tireSideImpulse)
                chassis:ApplyImpulse(wheel:tireSideImpulse, sidePoint)
            end
            if wheel:groundBody not= undefined and wheel:groundBody:GetInverseMass() > 0 and not wheel:tireSideImpulse:IsZero(0.000000119209290)
                Vector3 oppositeTireImpulse
                oppositeTireImpulse:Set(wheel:tireSideImpulse)
                oppositeTireImpulse:MakeOpposite()
                wheel:groundBody:ApplyImpulse(oppositeTireImpulse, wheel:tireGroundPoint)
            end
            Vector3 totalTorque
            totalTorque:Set(forwardTorque):Add(sideTorque)
            Vector3 angularAfter = chassis:GetAngularVelocity()
            //output "[TIRE-TORQUE] wheelIndex=" + wheelIndex + " front=" + wheel:frontWheel + " steering=" + wheel:steering + " forwardImpulse=(" + wheel:tireForwardImpulse:GetX() + "," + wheel:tireForwardImpulse:GetY() + "," + wheel:tireForwardImpulse:GetZ() + ") sideImpulse=(" + wheel:tireSideImpulse:GetX() + "," + wheel:tireSideImpulse:GetY() + "," + wheel:tireSideImpulse:GetZ() + ") forwardTorque=(" + forwardTorque:GetX() + "," + forwardTorque:GetY() + "," + forwardTorque:GetZ() + ") sideTorque=(" + sideTorque:GetX() + "," + sideTorque:GetY() + "," + sideTorque:GetZ() + ") totalTorque=(" + totalTorque:GetX() + "," + totalTorque:GetY() + "," + totalTorque:GetZ() + ") deltaAngularVelocity=(" + (angularAfter:GetX() - angularBefore:GetX()) + "," + (angularAfter:GetY() - angularBefore:GetY()) + "," + (angularAfter:GetZ() - angularBefore:GetZ()) + ")"
        end
    end

    private action Clamp(number value, number lower, number upper) returns number
        if value < lower
            return lower
        elseif value > upper
            return upper
        end
        return value
    end
end
