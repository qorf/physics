package Libraries.Game.Physics

use Libraries.Game.Layer3D
use Libraries.Interface.Item3D
use Libraries.Containers.Array
use Libraries.Compute.Vector3
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Compute.Math
use Libraries.Compute.Matrix3

/*
    Raycast vehicle modeled on Bullet's btRaycastVehicle. Each wheel casts a
    suspension ray; chassis impulses provide spring response, and contact point
    impulses provide steering, engine drive, braking, and tire friction.
    Axes follow Bullet's default convention: X right, Y up, Z forward.
*/
class Vehicle
    Math math
    public Layer3D world = undefined
    public Item3D chassis
    public Array<Suspension> wheels
    public number maxSuspensionTravel = 2.0
    public number steeringClamp = 0.30
    public number currentSpeedKPH = 0
    PhysicsRaycast raycast
    public number maxLateralImpulse = 25

    action Initialize(Layer3D layer, Item3D vehicleChassis)
        world = layer
        chassis = vehicleChassis
        PhysicsRaycast temp
        raycast = temp
    end

    action AddWheel(Item3D visual, Vector3 connection, Vector3 direction, Vector3 axle, number restLength, number radius, boolean frontWheel) returns Suspension
        if wheels = undefined
            Array<Suspension> temp
            wheels = temp
        end
        Suspension wheel
        wheel:Initialize(visual, connection, direction, axle, restLength, radius, frontWheel)
        wheels:Add(wheel)
        return wheel
    end

    action SetSteeringValue(number value, integer wheelIndex)
        Suspension wheel = wheels:Get(wheelIndex)
        wheel:steering = Clamp(value, -steeringClamp, steeringClamp)
    end

    action ApplyEngineForce(number force, integer wheelIndex)
     Suspension wheel = wheels:Get(wheelIndex)
        wheel:engineForce = force
    end

    action SetBrake(number force, integer wheelIndex)
        Suspension wheel = wheels:Get(wheelIndex)
        wheel:brake = math:MaximumOf(0, force)
    end

    action GetSpeedKPH returns number
        return currentSpeedKPH
    end

    /* Call once per physics update, using the same elapsed seconds as the world. */
    action Update(number timeStep)
if timeStep <= 0 or chassis = undefined
            return now
        end

        currentSpeedKPH = chassis:GetLinearVelocity():Length() * 3.6
        integer i = 0
        repeat while i < wheels:GetSize()
            UpdateWheel(wheels:Get(i), timeStep)
            i = i + 1
        end

        // Apply all accumulated impulses after all wheels have been calculated
        i = 0
        repeat while i < wheels:GetSize()
            ApplyStoredImpulses(wheels:Get(i))
            i = i + 1
        end
    end

    private action UpdateWheel(Suspension wheel, number timeStep)
        Vector3 chassisPos
        chassisPos:Set(chassis:GetX(), chassis:GetY(), chassis:GetZ())

        // Get chassis rotation and apply it to the connection point offset
        Matrix3 chassisRotation = chassis:GetCenterOfMassTransform():GetBasis()
        Vector3 rotatedOffset
        rotatedOffset:Set(wheel:connectionPointCS)
        chassisRotation:Transform(rotatedOffset)

        // Calculate hard point in world space: chassis position + rotated offset
        wheel:hardPointWS:Set(chassisPos)
        wheel:hardPointWS:Add(rotatedOffset)

        // Transform suspension direction from chassis-space to world-space
        wheel:directionWS:Set(wheel:directionCS)
        chassisRotation:Transform(wheel:directionWS)
        wheel:directionWS:Normalize()

        // Apply steering to axle in car space, then rotate to world space
        wheel:axleWS:Set(wheel:axleCS)
        if wheel:frontWheel
            number cosine = math:Cosine(wheel:steering)
            number sine = math:Sine(wheel:steering)
            // Rotation around Y axis (vertical in Quorum's Y-up): rotate in XZ plane
            wheel:axleWS:Set(cosine * wheel:axleCS:GetX() - sine * wheel:axleCS:GetZ(), wheel:axleCS:GetY(), sine * wheel:axleCS:GetX() + cosine * wheel:axleCS:GetZ())
        end

        // Rotate axle by chassis rotation to get world space
        chassisRotation:Transform(wheel:axleWS)
        wheel:axleWS:Normalize()

        number rayLength = wheel:restLength + wheel:radius + maxSuspensionTravel
        Vector3 rayEnd
        rayEnd:Set(wheel:directionWS)
        rayEnd:Scale(rayLength)
        rayEnd:Add(wheel:hardPointWS)

        // Sanity check: hard point should be near chassis (within reasonable bounds)
        number hardPointY = wheel:hardPointWS:GetY()
        boolean hardPointValid = hardPointY > -1000 and hardPointY < 1000

        boolean hitDetected = false
        if raycast not= undefined and hardPointValid
            raycast:Cast(world, wheel:hardPointWS, rayEnd, chassis)
            hitDetected = raycast:hit
        elseif not hardPointValid
            //output "WARNING: Invalid hard point Y = " + hardPointY + " (chassis Y = " + chassis:GetY() + ")"
        end

        wheel:inContact = hitDetected
        wheel:suspensionForce = 0
        wheel:groundBody = undefined

        if hitDetected
            wheel:groundBody = raycast:hitBody
            wheel:contactPointWS:Set(raycast:hitPoint)
            wheel:contactNormalWS:Set(raycast:hitNormal)
            number hitDistance = rayLength * raycast:fraction
            wheel:suspensionLength = Clamp(hitDistance - wheel:radius, wheel:restLength - maxSuspensionTravel, wheel:restLength + maxSuspensionTravel)

            Vector3 chassisRelativePoint
            chassisRelativePoint:Set(wheel:contactPointWS)
            chassisRelativePoint:Subtract(chassis:GetCenterOfMassTransform():GetOrigin())
            Vector3 chassisVelocity = chassis:GetLinearVelocityAtLocalPoint(chassisRelativePoint)
            output "[DEBUG-VELOCITY] wheel=" + wheel:wheelVisual:GetName() + " chassisVelocity=(" + chassisVelocity:GetX() + "," + chassisVelocity:GetY() + "," + chassisVelocity:GetZ() + ") angularVelocity=(" + chassis:GetAngularVelocity():GetX() + "," + chassis:GetAngularVelocity():GetY() + "," + chassis:GetAngularVelocity():GetZ() + ")"
            Vector3 relativeVelocity
            relativeVelocity:Set(chassisVelocity)
            Vector3 groundRelativePoint
            if wheel:groundBody not= undefined
                groundRelativePoint:Set(wheel:contactPointWS)
                groundRelativePoint:Subtract(wheel:groundBody:GetCenterOfMassTransform():GetOrigin())
                relativeVelocity:Subtract(wheel:groundBody:GetLinearVelocityAtLocalPoint(groundRelativePoint))
            end

            number normalSpeed = relativeVelocity:DotProduct(wheel:contactNormalWS)
            output "[WHEEL-VELOCITY] name=" + wheel:wheelVisual:GetName() + " normalSpeed=" + normalSpeed + " relativeVelocity=(" + relativeVelocity:GetX() + "," + relativeVelocity:GetY() + "," + relativeVelocity:GetZ() + ") contactNormal=(" + wheel:contactNormalWS:GetX() + "," + wheel:contactNormalWS:GetY() + "," + wheel:contactNormalWS:GetZ() + ")"
            number compression = wheel:restLength - wheel:suspensionLength
            number damping = wheel:dampingRelaxation
            if normalSpeed < 0
                damping = wheel:dampingCompression
            end
            // Bullet scales its spring and damping response by the chassis mass.
            wheel:suspensionForce = (wheel:suspensionStiffness * compression - damping * normalSpeed) * chassis:GetMass()
            wheel:suspensionForce = Clamp(wheel:suspensionForce, 0, wheel:maxSuspensionForce)

            output "[WHEEL] name=" + wheel:wheelVisual:GetName() + " compression=" + compression + " suspensionForce=" + wheel:suspensionForce + " contactNormal=(" + wheel:contactNormalWS:GetX() + "," + wheel:contactNormalWS:GetY() + "," + wheel:contactNormalWS:GetZ() + ") hardPointWS=(" + wheel:hardPointWS:GetX() + "," + wheel:hardPointWS:GetY() + "," + wheel:hardPointWS:GetZ() + ")"

            // Store suspension impulse for deferred application
            wheel:suspensionImpulse:Set(wheel:contactNormalWS)
            wheel:suspensionImpulse:Scale(wheel:suspensionForce * timeStep)
            wheel:suspensionChassisPoint:Set(chassisRelativePoint)
            wheel:suspensionGroundPoint:Set(groundRelativePoint)

            ApplyTireImpulses(wheel, relativeVelocity, chassisRelativePoint, timeStep)
        else
            wheel:suspensionLength = wheel:restLength + maxSuspensionTravel
        end

        if wheel:wheelVisual not= undefined
            Vector3 wheelPosition
            wheelPosition:Set(wheel:directionWS)
            wheelPosition:Scale(wheel:suspensionLength)
            wheelPosition:Add(wheel:hardPointWS)

            // Safety check: don't set wheel to invalid positions
            if wheelPosition:GetY() > -1000 and wheelPosition:GetY() < 1000
                wheel:wheelVisual:SetPosition(wheelPosition)
            end
        end
    end

    private action ApplyTireImpulses(Suspension wheel, Vector3 relativeVelocity, Vector3 chassisRelativePoint, number timeStep)
        Vector3 forward
        // Engine force direction: fixed toward +Z (where front wheels are)
        // Steering affects tire grip, not engine force direction
        forward:Set(0, 0, 1)

        output "[TIRE] name=" + wheel:wheelVisual:GetName() + " axleWS=(" + wheel:axleWS:GetX() + "," + wheel:axleWS:GetY() + "," + wheel:axleWS:GetZ() + ") forward=(" + forward:GetX() + "," + forward:GetY() + "," + forward:GetZ() + ") engineForce=" + wheel:engineForce + " isFront=" + wheel:frontWheel

        number lateralVelocity = relativeVelocity:DotProduct(wheel:axleWS)
        number forwardVelocity = relativeVelocity:DotProduct(forward)
        number lateralDenominator = chassis:ComputeImpulseDenominator(wheel:contactPointWS, wheel:axleWS)
        number forwardDenominator = chassis:ComputeImpulseDenominator(wheel:contactPointWS, forward)
        if wheel:groundBody not= undefined
            lateralDenominator = lateralDenominator + wheel:groundBody:ComputeImpulseDenominator(wheel:contactPointWS, wheel:axleWS)
            forwardDenominator = forwardDenominator + wheel:groundBody:ComputeImpulseDenominator(wheel:contactPointWS, forward)
        end

        number lateralImpulse = 0
        number forwardImpulse = wheel:engineForce * timeStep
        if lateralDenominator > 0.000001
            lateralImpulse = -lateralVelocity / lateralDenominator
        end
        if forwardDenominator > 0.000001
            number brakeImpulse = -forwardVelocity / forwardDenominator
            number brakeLimit = wheel:brake * timeStep
            brakeImpulse = Clamp(brakeImpulse, -brakeLimit, brakeLimit)
            forwardImpulse = forwardImpulse + brakeImpulse
        end




        number maxTireImpulse = wheel:frictionSlip * wheel:suspensionForce * timeStep
        number totalTireImpulse = math:SquareRoot(lateralImpulse * lateralImpulse + forwardImpulse * forwardImpulse)
        if totalTireImpulse > maxTireImpulse and totalTireImpulse > 0
            number tractionScale = maxTireImpulse / totalTireImpulse
            lateralImpulse = lateralImpulse * tractionScale
            forwardImpulse = forwardImpulse * tractionScale
        end

          // limit lateral forces to prevent yaw instability
        lateralImpulse = Clamp(lateralImpulse, -maxLateralImpulse, maxLateralImpulse)

        Vector3 tireImpulse
        tireImpulse:Set(wheel:axleWS)
        tireImpulse:Scale(lateralImpulse)
        Vector3 forwardPart
        forwardPart:Set(forward)
        forwardPart:Scale(forwardImpulse)
        tireImpulse:Add(forwardPart)

        output "[TIRE-IMPULSE] name=" + wheel:wheelVisual:GetName() + " lateralImpulse=" + lateralImpulse + " forwardImpulse=" + forwardImpulse + " tireImpulse=(" + tireImpulse:GetX() + "," + tireImpulse:GetY() + "," + tireImpulse:GetZ() + ") chassisRelPoint=(" + chassisRelativePoint:GetX() + "," + chassisRelativePoint:GetY() + "," + chassisRelativePoint:GetZ() + ")"

        // Store tire impulse for deferred application
        wheel:tireImpulse:Set(tireImpulse)
        wheel:tireChassisPoint:Set(chassisRelativePoint)
        Vector3 groundRelativePoint
        groundRelativePoint:Set(wheel:contactPointWS)
        groundRelativePoint:Subtract(wheel:groundBody:GetCenterOfMassTransform():GetOrigin())
        wheel:tireGroundPoint:Set(groundRelativePoint)
    end

    private action ApplyStoredImpulses(Suspension wheel)
        if wheel:inContact
            // Apply stored suspension impulse
            chassis:ApplyImpulse(wheel:suspensionImpulse, wheel:suspensionChassisPoint)
            if wheel:groundBody not= undefined and wheel:groundBody:GetInverseMass() > 0
                Vector3 oppositeImpulse
                oppositeImpulse:Set(wheel:suspensionImpulse)
                oppositeImpulse:MakeOpposite()
                wheel:groundBody:ApplyImpulse(oppositeImpulse, wheel:suspensionGroundPoint)
            end

            // Apply stored tire impulse
            chassis:ApplyImpulse(wheel:tireImpulse, wheel:tireChassisPoint)
            if wheel:groundBody not= undefined and wheel:groundBody:GetInverseMass() > 0
                Vector3 oppositeTireImpulse
                oppositeTireImpulse:Set(wheel:tireImpulse)
                oppositeTireImpulse:MakeOpposite()
                wheel:groundBody:ApplyImpulse(oppositeTireImpulse, wheel:tireGroundPoint)
            end
        end
    end

    private action Clamp(number value, number lower, number upper) returns number
        if value < lower
            return lower
        elseif value > upper
            return upper
        end
        return value
    end
    action GetMaxLateralImpulse returns number
        return maxLateralImpulse
    end

    action SetMaxLateralImpulse(number maxLateralImpulse)
        me:maxLateralImpulse = maxLateralImpulse
    end

end