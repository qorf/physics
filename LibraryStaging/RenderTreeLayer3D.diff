+    end
+
+    /*
+    This action adds to the results every item whose box is at least partly
+    inside the volume. A branch entirely inside the volume adds all of its
+    items without testing them, and a branch entirely outside is skipped.
+    */
+    action Collect(CullingVolume3D volume, Array<Item3D> results)
+        if root = undefined
+            return now
+        end
+
+        // Read once here, since reading a constant is an action call.
+        integer inside = volume:INSIDE
+        integer intersecting = volume:INTERSECTING
+
+        stack:Empty(false)
+        stack:Add(root)
+        repeat while not stack:IsEmpty()
+            RenderTreeNode3D node = stack:RemoveFromEnd()
+            integer result = volume:Test(node:GetBounds())
+            if result = inside
+                AddAll(node, results)
+            elseif result = intersecting
+                if node:IsLeaf()
+                    results:Add(node:GetItem())
+                else
+                    stack:Add(node:GetLeft())
+                    stack:Add(node:GetRight())
+                end
+            end
+        end
+    end
+
+    /*
+    This action adds to the results every item whose box overlaps the given
+    box.
+    */
+    action Collect(BoundingBox box, Array<Item3D> results)
+        if root = undefined
+            return now
+        end
+        stack:Empty(false)
+        stack:Add(root)
+        repeat while not stack:IsEmpty()
+            RenderTreeNode3D node = stack:RemoveFromEnd()
+            if node:GetBounds():TestOverlap(box)
+                if node:IsLeaf()
+                    results:Add(node:GetItem())
+                else
+                    stack:Add(node:GetLeft())
+                    stack:Add(node:GetRight())
+                end
+            end
+        end
+    end
+
+    /*
+    This action adds to the results every item whose box overlaps the sphere
+    with the given center and radius, as a point light's reach.
+    */
+    action Collect(number x, number y, number z, number radius, Array<Item3D> results)
+        if root = undefined
+            return now
+        end
+        number radiusSquared = radius * radius
+        stack:Empty(false)
+        stack:Add(root)
+        repeat while not stack:IsEmpty()
+            RenderTreeNode3D node = stack:RemoveFromEnd()
+            if DistanceSquared(node:GetBounds(), x, y, z) <= radiusSquared
+                if node:IsLeaf()
+                    results:Add(node:GetItem())
+                else
+                    stack:Add(node:GetLeft())
+                    stack:Add(node:GetRight())
+                end
+            end
+        end
+    end
+
+    /*
+    This action adds every item below the given node to the results, without
+    testing them.
+    */
+    private action AddAll(RenderTreeNode3D start, Array<Item3D> results)
+        subtreeStack:Empty(false)
+        subtreeStack:Add(start)
+        repeat while not subtreeStack:IsEmpty()
+            RenderTreeNode3D node = subtreeStack:RemoveFromEnd()
+            if node:IsLeaf()
