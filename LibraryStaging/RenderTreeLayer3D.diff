+        if cell:GetDepth() + 1 > deepest
+            deepest = cell:GetDepth() + 1
+        end
+    end
+
+    /*
+    This action returns the top cell, making it if needed. It is a square
+    (quadtree) or cube (octree) centered on the region, as big as the
+    region's largest side.
+    */
+    private action GetRoot returns RenderTreeCell3D
+        if root = undefined
+            number x = (regionMinimumX + regionMaximumX) / 2
+            number y = (regionMinimumY + regionMaximumY) / 2
+            number z = (regionMinimumZ + regionMaximumZ) / 2
+            number sideLength = regionMaximumX - regionMinimumX
+            if regionMaximumZ - regionMinimumZ > sideLength
+                sideLength = regionMaximumZ - regionMinimumZ
+            end
+            number bottom = regionMinimumY
+            number top = regionMaximumY
+            if splitsHeight
+                if regionMaximumY - regionMinimumY > sideLength
+                    sideLength = regionMaximumY - regionMinimumY
+                end
+                bottom = y - sideLength
+                top = y + sideLength
+            end
+
+            RenderTreeCell3D cell
+            cell:SetPlace(x, y, z, sideLength, bottom, top)
+            root = cell
+            if deepest < 0
+                deepest = 0
+            end
+        end
+        return root
+    end
+
+    /*
+    This action places every leaf again, after the region, the maximum depth
+    or the kind of tree changes. The leaves keep their boxes.
+    */
+    private action Rebuild
+        if leafCount = 0
+            root = undefined
+            deepest = -1
+            return now
+        end
+
+        replaceLeaves:Empty(false)
+        integer i = 0
+        repeat while i < outsideLeaves:GetSize()
+            replaceLeaves:Add(outsideLeaves:Get(i))
+            i = i + 1
+        end
+        if root not= undefined
+            subtreeStack:Empty(false)
+            subtreeStack:Add(root)
+            repeat while not subtreeStack:IsEmpty()
+                RenderTreeCell3D cell = subtreeStack:RemoveFromEnd()
+                i = 0
+                repeat while i < cell:GetLeafCount()
+                    replaceLeaves:Add(cell:GetLeaf(i))
+                    i = i + 1
+                end
+                integer c = 0
+                repeat while c < cell:GetChildCount()
+                    subtreeStack:Add(cell:GetChild(c))
+                    c = c + 1
+                end
+            end
+        end
+
+        root = undefined
+        deepest = -1
+        outsideLeaves:Empty()
+        i = 0
+        repeat while i < replaceLeaves:GetSize()
+            RenderTreeNode3D leaf = replaceLeaves:Get(i)
+            leaf:SetCell(undefined)
+            leaf:SetCellIndex(-1)
+            Place(leaf)
+            i = i + 1
+        end
+        replaceLeaves:Empty()
+    end
+end
