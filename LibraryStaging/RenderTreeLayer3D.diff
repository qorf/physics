+package Libraries.Game.Graphics.Trees
+
+use Libraries.Game.BoundingBox
+use Libraries.Containers.Array
+use Libraries.Interface.Item3D
+
+/*
+RenderBoundingVolumeTree3D is a dynamic bounding volume tree for drawing: a
+binary tree of boxes, where each leaf holds one drawable item and each branch
+holds the box around its two children. A search can skip a whole branch when
+its box is out of view.
+
+The algorithm is the one used by the physics tree, DynamicBoundingVolumeTree3D,
+which comes from Box2D and Bullet. Inserting walks down from the root,
+choosing the child whose box grows least, measured by perimeter. Removing
+replaces the leaf's parent with its sibling. Both refit the boxes above and
+rebalance with rotations, so the tree stays shallow. This class is a separate
+copy rather than a shared one, so that drawing can change without any risk to
+physics. A fix to the shared algorithm in either class should be checked in
+the other.
+
+DynamicVolumeRenderTree uses two of these, as the parts of a
+StaticDynamicRenderTree3D: a static half with no margin, and a dynamic half
+whose leaves are made a little bigger than their items, so small moves need
+no change to the tree.
+
+The leaves belong to the render tree, which moves them between the two
+halves. This class creates and reuses only the branch nodes. The margin,
+SetLeafBounds, Contains and DistanceSquared come from RenderTreePart3D.
+*/
+class RenderBoundingVolumeTree3D is RenderTreePart3D
+    RenderTreeNode3D root = undefined
+
+    integer leafCount = 0
+
+    // Branch nodes that have been removed, kept for reuse so the tree does
+    // not create objects while items move. An Array, not a List, because a
+    // List creates a node object for every Add.
+    Array<RenderTreeNode3D> freeNodes
+
+    // Reused by the searches, as stacks of nodes still to visit. They are
+    // emptied with Empty(false), which keeps their storage, so searching
+    // creates no objects once the stacks have grown to fit the tree.
+    Array<RenderTreeNode3D> stack
+    Array<RenderTreeNode3D> subtreeStack
+
+    BoundingBox combined
+
+    /*
+    This action returns how many items, or leaves, the tree holds.
+    */
+    action GetSize returns integer
+        return leafCount
+    end
+
+    /*
+    This action returns how many levels the tree has below its root, or -1
+    when it is empty.
+    */
+    action GetHeight returns integer
+        if root = undefined
+            return -1
+        end
+        return root:GetHeight()
+    end
+
+    /*
+    This action adds a leaf, with a box around the given bounds of its item.
+    */
+    action Insert(RenderTreeNode3D leaf, BoundingBox itemBounds)
+        SetLeafBounds(leaf, itemBounds)
+        InsertLeaf(leaf)
+        leafCount = leafCount + 1
+    end
+
+    /*
+    This action removes a leaf. The leaf itself is not reused here, since
+    it belongs to RenderTree3D.
+    */
+    action Remove(RenderTreeNode3D leaf)
+        RemoveLeaf(leaf)
+        leafCount = leafCount - 1
+    end
+
+    /*
+    This action removes every leaf. The branch nodes are dropped rather than
+    kept for reuse, since emptying is rare.
+    */
