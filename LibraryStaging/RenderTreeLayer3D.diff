@@ -0,0 +1,314 @@
+package Libraries.Game.Graphics.Trees
+
+use Libraries.Containers.Array
+use Libraries.Containers.HashTable
+use Libraries.Containers.Iterator
+use Libraries.Interface.Item3D
+use Libraries.Game.BoundingBox
+use Libraries.Game.Graphics.PointLight
+use Libraries.Game.Graphics.DirectionalLight
+use Libraries.Game.Graphics.CascadeShadowData
+use Libraries.Compute.Matrix4
+
+/*
+StaticDynamicRenderTree3D is the work shared by DynamicVolumeRenderTree,
+QuadTree3D and Octree. It keeps items in two parts, each a RenderTreePart3D:
+
+- The static part holds items that do not move, such as scenery and terrain
+  chunks.
+- The dynamic part holds items that move.
+
+A static item that moves is moved to the dynamic part. A dynamic item that
+has not moved for a while is moved back to the static part by EndFrame.
+Because static items never move, what is worked out from them can be kept:
+the static items within each point light's reach are found once and
+remembered until the static part changes.
+
+The kinds of tree differ only in their parts. Each one makes its two parts
+and hands them to SetParts when it is created. This class is not meant to be
+used on its own.
+*/
+class StaticDynamicRenderTree3D is RenderTree3D
+    // How many frames a dynamic item must stay still before it is moved to
+    // the static part.
+    constant integer FRAMES_UNTIL_STATIC = 120
+
+    // How often, in frames, still dynamic items are checked.
+    constant integer CHECK_INTERVAL = 30
+
+    RenderTreePart3D staticPart = undefined
+    RenderTreePart3D dynamicPart = undefined
+
+    // The leaf for each item in the tree.
+    HashTable<Item3D, RenderTreeNode3D> leaves
+
+    // The leaves in the dynamic part, checked by EndFrame.
+    Array<RenderTreeNode3D> dynamicLeaves
+
+    HashTable<PointLight, ShadowCasterCache3D> pointLightCasters
+
+    integer frame = 0
+    integer staticVersion = 0
+
+    CullingVolume3D volume
+    BoundingBox worldBounds
+
+    /*
+    This action sets the two parts. Each kind of tree calls it once, when it
+    is created.
+
+    Attribute: Parameter staticItems The part for items that do not move.
+    Attribute: Parameter dynamicItems The part for items that move.
+    */
+    action SetParts(RenderTreePart3D staticItems, RenderTreePart3D dynamicItems)
+        staticPart = staticItems
+        dynamicPart = dynamicItems
+    end
+
+    action Add(Item3D item, BoundingBox localBounds, boolean isStatic) returns boolean
+        if item = undefined or Has(item)
+            return false
+        end
+
+        RenderTreeNode3D leaf
+        leaf:SetItem(item)
+        leaf:SetLocalBounds(localBounds)
+        leaf:SetLastMovedFrame(frame)
+        CalculateWorldBounds(leaf, worldBounds)
+
+        if isStatic
+            leaf:SetStatic(true)
+            staticPart:Insert(leaf, worldBounds)
+            staticVersion = staticVersion + 1
+        else
+            dynamicPart:Insert(leaf, worldBounds)
+            dynamicLeaves:Add(leaf)
+        end
+        leaves:Add(item, leaf)
+        return true
+    end
+
+    action Remove(Item3D item) returns boolean
+        if item is PointLight
+            pointLightCasters:RemoveKey(cast(PointLight, item))
+        end
+
+        RenderTreeNode3D leaf = leaves:RemoveKey(item)
+        if leaf = undefined
+            return false
+        end
+
+        if leaf:IsStatic()
+            staticPart:Remove(leaf)
+            staticVersion = staticVersion + 1
+        else
+            dynamicPart:Remove(leaf)
+            dynamicLeaves:Remove(leaf)
+        end
+        leaf:Reset()
+        return true
+    end
+
+    action Empty
+        Iterator<RenderTreeNode3D> iterator = leaves:GetValueIterator()
+        repeat while iterator:HasNext()
+            iterator:Next():Reset()
+        end
+        staticPart:Empty()
+        dynamicPart:Empty()
+        leaves:Empty()
+        dynamicLeaves:Empty()
+        pointLightCasters:Empty()
+        staticVersion = staticVersion + 1
+    end
+
+    action Has(Item3D item) returns boolean
+        return leaves:HasKey(item)
+    end
