+package Libraries.Game.Graphics.Trees
+
+use Libraries.Game.BoundingBox
+use Libraries.Interface.Item3D
+
+/*
+RenderTreeNode3D is the record a render tree keeps for each item: the item,
+its bounds, and which half of the tree it is in. It is called a leaf.
+
+In a RenderBoundingVolumeTree3D, nodes are also the tree itself. A node is
+either a leaf, which holds one drawable item and the box around it, or a
+branch, which holds two children and the box around both. The parent, left,
+right and height fields are used only there.
+
+In a RenderCellTree3D, used by QuadTree3D and Octree, a leaf instead records
+the cell it is in and its place in that cell's list, so it can be removed
+without searching.
+
+Only the tree classes in this package should change a node.
+
+A node's box can be read two ways. GetBounds returns the node's own box,
+not a copy, so changing it changes the node. The tree uses it to update
+boxes in place without making new objects. GetBoundsCopy returns a new box
+with the same corners, which can be changed freely, but makes a new object
+on every call.
+*/
+class RenderTreeNode3D
+    // The box this node covers. For a leaf in the dynamic half of the tree it
+    // is a little bigger than the item, so small moves do not change the tree.
+    BoundingBox bounds
+
+    RenderTreeNode3D parentNode = undefined
+    RenderTreeNode3D left = undefined
+    RenderTreeNode3D right = undefined
+
+    // How many levels are below this node. A leaf is 0.
+    integer height = 0
+
+    // The item a leaf holds. Branches hold no item.
+    Item3D item = undefined
+
+    // Whether the leaf is in the static half of the tree.
+    boolean isStatic = false
+
+    // The frame the leaf last moved on, used to move still items back to
+    // the static half.
+    integer lastMovedFrame = 0
+
+    // The last frame the owner handed this leaf's item to be drawn, kept by
+    // the owner, such as Layer3D, so an item found by more than one search
+    // in a frame is only drawn once.
+    integer lastDrawnFrame = -1
+
+    // The cell of a RenderCellTree3D the leaf is in, and its place in the
+    // cell's list of leaves. A leaf in the cell tree's list of leaves outside
+    // its region has no cell, but still has a place in that list.
+    RenderTreeCell3D cell = undefined
+    integer cellIndex = -1
+
+    // The item's bounds in its own coordinates, as a center and half sizes.
+    // They are turned into world bounds each time the item moves.
+    number localCenterX = 0
+    number localCenterY = 0
+    number localCenterZ = 0
+    number localHalfX = 0
+    number localHalfY = 0
+    number localHalfZ = 0
+
+    /*
+    This action returns the box this node covers. The box itself is
+    returned, not a copy, so changing it changes the node. The tree uses
+    this to update boxes in place without making new objects. To look at
+    the box without any risk of changing the node, use GetBoundsCopy.
+
+    Attribute: Returns The node's own box, not a copy.
+    */
+    action GetBounds returns BoundingBox
+        return bounds
+    end
+
+    /*
+    This action returns a new box with the same corners as the box this
+    node covers. Changing the copy does not change the node. Each call makes
+    a new object, so code that runs every frame should use GetBounds
+    instead, and only read from it.
+
+    Attribute: Returns A copy of the node's box.
+    */
+    action GetBoundsCopy returns BoundingBox
+        return bounds:Copy()
+    end
+
+    /*
+    This action returns the branch above this node, or undefined if this
+    node is the root.
+    */
+    action GetParentNode returns RenderTreeNode3D
+        return parentNode
+    end
+
+    action SetParentNode(RenderTreeNode3D node)
+        parentNode = node
+    end
+
+    /*
+    This action returns the first child of a branch, or undefined for a
+    leaf.
+    */
+    action GetLeft returns RenderTreeNode3D
+        return left
+    end
+
+    action SetLeft(RenderTreeNode3D node)
+        left = node
+    end
+
+    /*
+    This action returns the second child of a branch, or undefined for a
+    leaf.
+    */
+    action GetRight returns RenderTreeNode3D
+        return right
+    end
+
+    action SetRight(RenderTreeNode3D node)
+        right = node
+    end
+
+    /*
+    This action returns how many levels are below this node. A leaf is 0.
+    */
+    action GetHeight returns integer
+        return height
+    end
+
+    action SetHeight(integer value)
+        height = value
+    end
+
+    /*
+    This action returns the item a leaf holds, or undefined for a branch.
+    */
+    action GetItem returns Item3D
+        return item
+    end
+
+    action SetItem(Item3D value)
+        item = value
+    end
+
+    /*
+    This action returns true if the leaf is in the static half of the tree.
+    */
+    action IsStatic returns boolean
+        return isStatic
+    end
+
+    action SetStatic(boolean value)
+        isStatic = value
+    end
+
+    /*
+    This action returns the frame the leaf last moved on.
+    */
+    action GetLastMovedFrame returns integer
+        return lastMovedFrame
+    end
+
+    action SetLastMovedFrame(integer frame)
+        lastMovedFrame = frame
+    end
+
+    /*
+    This action returns the last frame the leaf's item was handed to be
+    drawn, or -1 if it never has been. The tree does not use this. It is
+    kept for the tree's owner.
+    */
+    action GetLastDrawnFrame returns integer
+        return lastDrawnFrame
+    end
+
+    action SetLastDrawnFrame(integer frame)
+        lastDrawnFrame = frame
+    end
+
+    /*
+    This action returns the RenderCellTree3D cell the leaf is in, or
+    undefined if it is in none.
+    */
+    action GetCell returns RenderTreeCell3D
+        return cell
+    end
+
+    action SetCell(RenderTreeCell3D value)
+        cell = value
+    end
+
+    /*
+    This action returns the leaf's place in its cell's list of leaves, or in
+    the cell tree's list of leaves outside its region, or -1 if it is in
+    neither.
+    */
+    action GetCellIndex returns integer
+        return cellIndex
+    end
+
+    action SetCellIndex(integer index)
+        cellIndex = index
+    end
+
+    /*
+    These actions return the item's bounds in its own coordinates, as a
+    center and half sizes. They are set together with SetLocalBounds.
+    */
+    action GetLocalCenterX returns number
+        return localCenterX
+    end
+
+    action GetLocalCenterY returns number
+        return localCenterY
+    end
+
+    action GetLocalCenterZ returns number
+        return localCenterZ
+    end
+
+    action GetLocalHalfX returns number
+        return localHalfX
+    end
+
+    action GetLocalHalfY returns number
+        return localHalfY
+    end
+
+    action GetLocalHalfZ returns number
+        return localHalfZ
+    end
+
+    /*
+    This action returns true if this node is a leaf, which holds an item.
+    */
+    action IsLeaf returns boolean
+        return left = undefined
+    end
+
+    /*
+    This action clears the node so it can be reused for another item or
+    branch.
+    */
+    action Reset
+        parentNode = undefined
+        left = undefined
+        right = undefined
+        height = 0
+        item = undefined
+        isStatic = false
+        lastMovedFrame = 0
+        lastDrawnFrame = -1
+        cell = undefined
+        cellIndex = -1
+        bounds:Invalidate()
+    end
+
+    /*
+    This action sets the item's bounds in its own coordinates.
+    */
+    action SetLocalBounds(BoundingBox local)
+        localCenterX = local:GetCenterX()
+        localCenterY = local:GetCenterY()
+        localCenterZ = local:GetCenterZ()
+        localHalfX = local:GetWidth() / 2
+        localHalfY = local:GetHeight() / 2
+        localHalfZ = local:GetDepth() / 2
+    end
+end
