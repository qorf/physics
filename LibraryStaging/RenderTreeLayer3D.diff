+        number cy = leaf:GetLocalCenterY()
+        number cz = leaf:GetLocalCenterZ()
+        number hx = leaf:GetLocalHalfX()
+        number hy = leaf:GetLocalHalfY()
+        number hz = leaf:GetLocalHalfZ()
