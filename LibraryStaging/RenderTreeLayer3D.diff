+package Libraries.Game.Graphics.Trees
+
+use Libraries.Interface.Item2D
+
+/*
+QuadTreeLeaf2D is the record a QuadTree2D keeps for each item: the item, the
+rectangle around it in the world, and where it is in the tree. It is the 2D
+partner of RenderTreeNode3D.
+
+Only QuadTree2D and QuadTreeCell2D should change a leaf.
+*/
+class QuadTreeLeaf2D
+    Item2D item = undefined
+
+    // The rectangle around the item in world coordinates, as its corners.
+    number minimumX = 0
+    number minimumY = 0
+    number maximumX = 0
+    number maximumY = 0
+
+    // The cell the leaf is in, and its place in the cell's list of leaves. A
+    // leaf in the tree's list of leaves outside its region has no cell, but
+    // still has a place in that list.
+    QuadTreeCell2D cell = undefined
+    integer cellIndex = -1
+
+    // The last frame the owner handed this leaf's item to be drawn, kept by
+    // the owner so an item found twice in a frame is only drawn once.
+    integer lastDrawnFrame = -1
+
+    action GetItem returns Item2D
+        return item
+    end
+
+    action SetItem(Item2D value)
+        item = value
+    end
+
+    /*
+    This action sets the rectangle around the item, in world coordinates.
+    */
+    action SetBounds(number minX, number minY, number maxX, number maxY)
+        minimumX = minX
+        minimumY = minY
+        maximumX = maxX
+        maximumY = maxY
+    end
+
+    action GetMinimumX returns number
+        return minimumX
+    end
+
+    action GetMinimumY returns number
+        return minimumY
+    end
+
+    action GetMaximumX returns number
+        return maximumX
+    end
+
+    action GetMaximumY returns number
+        return maximumY
+    end
+
+    /*
+    This action returns true if the leaf's rectangle has these corners.
+    */
+    action HasBounds(number minX, number minY, number maxX, number maxY) returns boolean
+        return minimumX = minX and minimumY = minY and maximumX = maxX and maximumY = maxY
+    end
+
+    /*
+    This action returns true if the leaf's rectangle overlaps the given one.
+    Touching edges count as overlapping.
+    */
+    action Overlaps(number minX, number minY, number maxX, number maxY) returns boolean
+        return minimumX <= maxX and maximumX >= minX and minimumY <= maxY and maximumY >= minY
+    end
+
+    action GetCell returns QuadTreeCell2D
+        return cell
+    end
+
+    action SetCell(QuadTreeCell2D value)
+        cell = value
+    end
+
+    action GetCellIndex returns integer
+        return cellIndex
+    end
+
+    action SetCellIndex(integer index)
+        cellIndex = index
+    end
+
+    /*
+    This action returns the last frame the leaf's item was handed to be
+    drawn, or -1 if it never has been. The tree does not use this.
+    */
+    action GetLastDrawnFrame returns integer
+        return lastDrawnFrame
+    end
+
+    action SetLastDrawnFrame(integer frame)
+        lastDrawnFrame = frame
+    end
+
+    /*
+    This action clears the leaf.
+    */
+    action Reset
+        item = undefined
+        minimumX = 0
+        minimumY = 0
+        maximumX = 0
+        maximumY = 0
+        cell = undefined
+        cellIndex = -1
+        lastDrawnFrame = -1
+    end
+end
