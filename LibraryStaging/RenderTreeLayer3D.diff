+            index = index + 1
+        end
+        if z >= cell:GetCenterZ()
+            index = index + 2
+        end
+        if splitsHeight and y >= cell:GetCenterY()
+            index = index + 4
+        end
+        return index
+    end
+
+    /*
+    This action splits a cell into 4 children, or 8 in an octree, each half
+    its size, numbered as ChildIndex expects.
+    */
+    private action Split(RenderTreeCell3D cell)
+        integer childCount = 4
+        if splitsHeight
+            childCount = 8
+        end
+        number childSize = cell:GetSize() / 2
+        number quarter = cell:GetSize() / 4
+
+        integer i = 0
+        repeat while i < childCount
+            number x = cell:GetCenterX() - quarter
+            if i mod 2 = 1
+                x = cell:GetCenterX() + quarter
+            end
+            number z = cell:GetCenterZ() - quarter
+            if i mod 4 >= 2
+                z = cell:GetCenterZ() + quarter
+            end
+            number y = cell:GetCenterY()
+            number bottom = regionMinimumY
+            number top = regionMaximumY
+            if splitsHeight
+                y = cell:GetCenterY() - quarter
+                if i >= 4
+                    y = cell:GetCenterY() + quarter
+                end
+                bottom = y - childSize
+                top = y + childSize
+            end
+
+            RenderTreeCell3D child
+            child:SetPlace(x, y, z, childSize, bottom, top)
+            child:SetDepth(cell:GetDepth() + 1)
+            child:SetParentCell(cell)
+            cell:AddChild(child)
+            i = i + 1
+        end
