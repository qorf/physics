use Libraries.Testing.Tester
use Libraries.Testing.Test
use Libraries.Containers.Iterator
use Libraries.Language.Compile.Test.WorldsTester

/*
RunWorldTests runs the terrain and world tests in this project and writes
which of them failed. It works like RunPhysicsTests, so the tests in
Tests/Worlds and Tests/WorldsTester.quorum can be copied into Quorum
unchanged. To run it, make this file the project's main file.

A test that stops with an error has no message, since the Tester catches
the error. Such a test is run again here, and the error and where it
happened are written out.
*/
class RunWorldTests
    action Main
        Tester tester
        WorldsTester worlds
        worlds:SetTester(tester)
        worlds:Test()

        output worlds:GetName() + ": " + tester:GetPassingSize() + " of " + tester:GetSize() + " passed."

        Iterator<Test> failures = tester:GetFailedTestsIterator()
        repeat while failures:HasNext()
            Test test = failures:Next()
            output "FAILED: " + test:GetName()
            if test:GetMessage() not= ""
                output "    " + test:GetMessage()
            else
                // No message means the test stopped with an error, which the
                // Tester catches and hides. Run it again here to show it.
                check
                    test:Run()
                    output "    (no error on a second run)"
                detect e
                    output "    Error: " + e:GetErrorMessage()
                    output e:GetStackTraceMessage()
                end
            end
        end
    end
end
