use Libraries.Game.Game
use Libraries.Game.InputMonitor
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Label
use Libraries.Game.Graphics.Skybox
use Libraries.Game.Graphics.AmbientLight
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Compute.Math

/*
SkyboxCheck tests the skybox on the new shader system (library item 26,
Item26.md), under Vulkan or OpenGL: set useVulkan below to switch.

The sky is made-up test images in Skyboxes/Check, each side one color:

| Side | Color |
|---|---|
| front (+z) | red |
| back | cyan |
| left | green |
| right | magenta |
| top | white |
| bottom | dark grey |

Each has a yellow bar along its top edge and a blue square near its right
edge, so a side that is turned or mirrored shows. A thin dark border marks
the cube's edges.

What to see:
1. At start, facing +z: red, with the yellow bar at the top and the blue
   square on the right.
2. Turning right shows magenta, left green, behind cyan, each upright with
   its square on the right. Looking up shows white, with its yellow bar
   toward the back. Looking down shows grey, with its bar toward the front.
3. Moving with W and S doesn't move the sky.
4. V adds two solid boxes and a half-transparent one in front. The boxes
   cover the sky, and the sky shows through the half-transparent box.
5. No seams along the cube's edges, apart from the drawn borders.
6. R turns the sky around the vertical, and I mirrors it left to right.
7. Resizing the window keeps the sky's proportions.

Keys: Left and Right turn, Up and Down tilt, W and S move, R turns the sky,
I mirrors it, V adds or removes the boxes, F says where the camera faces.

Attribute: Example
// SkyboxCheck is a main program: set it as the project's main file and run
// it.
*/
class SkyboxCheck is Game
    boolean useVulkan = true

    Skybox skybox
    Label label
    InputMonitor monitor
    KeyboardEvent keys
    Math math
    DirectionalLight sun
    AmbientLight ambient
    Model leftBox
    Model rightBox
    Model glassBox

    // The camera's position and which way it faces, in degrees: yaw 0 faces
    // +z, positive yaw turns right; positive pitch looks up.
    number cameraX = 0
    number cameraY = 1
    number cameraZ = 0
    number yaw = 0
    number pitch = 0

    boolean skyTurning = false
    boolean boxesShown = false
    boolean rWasDown = false
    boolean iWasDown = false
    boolean vWasDown = false
    boolean fWasDown = false

    action Main
        SetScreenSize(1000, 600)
        UseVulkan(useVulkan)
        StartGame()
    end

    action CreateGame
        text folder = "Skyboxes/Check/"
        skybox:Load(folder + "right.png", folder + "left.png", folder + "top.png", folder + "bottom.png",
            folder + "front.png", folder + "back.png")
        SetSkybox(skybox)

        Color colors
        sun:SetColor(colors:White())
        sun:SetIntensity(1.5)
        sun:SetDirection(0.3, -1, 0.5)
        Add(sun)
        ambient:SetColor(0.4, 0.4, 0.4, 1)
        SetAmbientLight(ambient)

        leftBox:LoadBox(1, 1, 1, colors:Orange())
        leftBox:SetPosition(-1.5, 1, 5)
        rightBox:LoadBox(1, 1, 1, colors:Yellow())
        rightBox:SetPosition(1.5, 1, 5)
        glassBox:LoadBox(1.5, 1.5, 0.2, colors:CustomColor(0.6, 0.8, 1, 0.5))
        glassBox:SetPosition(0, 1, 4)

        PlaceCamera()

        label:SetPosition(10, 10)
        label:SetText("Arrows turn and tilt, W S move, R turn the sky, I mirror it, V boxes, F facing")
        Add(label)

        text renderer = "OpenGL"
        if useVulkan
            renderer = "Vulkan"
        end
        output "Skybox check (" + renderer + "): started, facing +z. You should see red, yellow bar on top, blue square on the right."
    end

    action Update(number seconds)
        number turnSpeed = 60
        if monitor:IsKeyPressed(keys:LEFT)
            yaw = yaw - turnSpeed * seconds
        end
        if monitor:IsKeyPressed(keys:RIGHT)
            yaw = yaw + turnSpeed * seconds
        end
        if monitor:IsKeyPressed(keys:UP)
            pitch = math:Clamp(pitch + turnSpeed * seconds, -89, 89)
        end
        if monitor:IsKeyPressed(keys:DOWN)
            pitch = math:Clamp(pitch - turnSpeed * seconds, -89, 89)
        end
        number moveSpeed = 4
        number yawRadians = math:DegreesToRadians(yaw)
        if monitor:IsKeyPressed(keys:W)
            cameraX = cameraX + math:Sine(yawRadians) * moveSpeed * seconds
            cameraZ = cameraZ + math:Cosine(yawRadians) * moveSpeed * seconds
        end
        if monitor:IsKeyPressed(keys:S)
            cameraX = cameraX - math:Sine(yawRadians) * moveSpeed * seconds
            cameraZ = cameraZ - math:Cosine(yawRadians) * moveSpeed * seconds
        end
        PlaceCamera()

        boolean rDown = monitor:IsKeyPressed(keys:R)
        if rDown and not rWasDown
            skyTurning = not skyTurning
            if skyTurning
                output "Skybox check: the sky turns."
            else
                output "Skybox check: the sky stops turning."
            end
        end
        rWasDown = rDown
        if skyTurning
            skybox:Rotate(0, 1, 0, 15 * seconds)
        end

        boolean iDown = monitor:IsKeyPressed(keys:I)
        if iDown and not iWasDown
            skybox:InvertSkybox(not skybox:IsInverted())
            if skybox:IsInverted()
                output "Skybox check: the sky as it is (InvertSkybox true, the default)."
            else
                output "Skybox check: the sky mirrored left to right (InvertSkybox false)."
            end
        end
        iWasDown = iDown

        boolean vDown = monitor:IsKeyPressed(keys:V)
        if vDown and not vWasDown
            if boxesShown
                Remove(leftBox)
                Remove(rightBox)
                Remove(glassBox)
                boxesShown = false
                output "Skybox check: boxes removed."
            else
                Add(leftBox)
                Add(rightBox)
                Add(glassBox)
                boxesShown = true
                output "Skybox check: two solid boxes, and a half-transparent one in front, ahead of the start."
            end
        end
        vWasDown = vDown

        boolean fDown = monitor:IsKeyPressed(keys:F)
        if fDown and not fWasDown
            output "Skybox check: facing " + DescribeFacing() + " (yaw " + math:Round(yaw, 0) + ", pitch " +
                math:Round(pitch, 0) + "), at (" + math:Round(cameraX, 1) + ", " + math:Round(cameraY, 1) + ", " +
                math:Round(cameraZ, 1) + ")."
        end
        fWasDown = fDown
    end

    /*
    This action puts the camera at its position, facing by its yaw and
    pitch.
    */
    action PlaceCamera
        number yawRadians = math:DegreesToRadians(yaw)
        number pitchRadians = math:DegreesToRadians(pitch)
        number directionX = math:Sine(yawRadians) * math:Cosine(pitchRadians)
        number directionY = math:Sine(pitchRadians)
        number directionZ = math:Cosine(yawRadians) * math:Cosine(pitchRadians)
        GetCamera3D():SetPosition(cameraX, cameraY, cameraZ)
        GetCamera3D():LookAt(cameraX + directionX, cameraY + directionY, cameraZ + directionZ)
    end

    /*
    This action names the side of the sky the camera faces most, and the
    color that side should be.

    Attribute: Returns The side and its color.
    */
    action DescribeFacing returns text
        if pitch > 45
            return "up (white)"
        elseif pitch < -45
            return "down (grey)"
        end
        // The yaw brought into 0 to 360.
        number turned = yaw - 360 * math:Floor(yaw / 360)
        if turned < 45 or turned >= 315
            return "front, +z (red)"
        elseif turned < 135
            return "right, +x (magenta)"
        elseif turned < 225
            return "back, -z (cyan)"
        end
        return "left, -x (green)"
    end
end
