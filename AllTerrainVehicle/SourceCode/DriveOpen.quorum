use Libraries.Game.Game
use Libraries.Game.InputMonitor
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.Skybox
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Game.Graphics.PointLight
use Libraries.Game.Graphics.SpotLight
use Libraries.Game.Graphics.PixelMap
use Libraries.Game.Graphics.Format
use Libraries.Game.Graphics.Worlds.WorldTerrain
use Libraries.Game.Graphics.Worlds.TerrainData
use Libraries.Game.Graphics.Worlds.TerrainRegionModel
use Libraries.Game.Graphics.Worlds.TerrainRegion
use Libraries.Game.Graphics.Worlds.TerrainCollision
use Libraries.Game.Graphics.Worlds.TerrainStreamer
use Libraries.Game.Graphics.Worlds.TextureSplat
use Libraries.Game.Graphics.Worlds.TerrainSplatShaderProgram
use Libraries.Game.Graphics.Models.Data.Material
use Libraries.Game.Graphics.Texture
use Libraries.Game.GameStateManager
use Libraries.Game.Graphics.Vulkan.VulkanGraphics
use Libraries.Game.Graphics.Models.Vulkan.ModelBlueprintVulkan
use Libraries.Game.Graphics.Models.Vulkan.MaterialVulkan
use Libraries.Game.Graphics.Models.Vulkan.ModelResourcesVulkan
use Libraries.Compute.Vector3
use Libraries.System.File
use Libraries.Compute.Matrix3
use Libraries.Compute.Math
use Libraries.Compute.BitwiseOperations
use Libraries.Compute.Noise.PerlinNoise
use Libraries.Compute.Random
use Libraries.Containers.Array
use Libraries.Game.Physics.PhysicsProperties3D
use Libraries.Interface.Item3D
use Libraries.Interface.Events.KeyboardEvent
use Libraries.Game.Physics.Vehicles.Vehicle
use Libraries.Game.Physics.Vehicles.Suspension
use Libraries.Interface.Behaviors.Games.VehicleMovementBehavior
use Libraries.Game.Graphics.FramesPerSecondLabel
use RenderingChecks.RenderTreeCheck
use Libraries.Game.Graphics.Trees.QuadTree3D
use Libraries.Game.Graphics.Trees.Octree3D
use Libraries.Game.Graphics.Label
use Libraries.Game.Layer3D
use Libraries.Game.Collision.Shapes.Box
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Game.DesktopConfiguration

/*
    A raycast vehicle driving over rolling hills. The hills are a WorldTerrain,
    split into many square regions that are each drawn and collided with on
    their own, so the vehicle crosses from region to region as it drives. The
    heights come from a height map that is generated with Perlin noise, so no
    image file is needed. Arrow keys drive and steer, the space bar brakes, and R puts the
    vehicle back on its wheels in the middle of the map.

    To give the physics something to show, small balls rain down on the
    terrain at random places. Each one is a full physics object, so they roll
    down the hills, pile up, bounce off the vehicle, and can be driven over.

    Stacks of boxes stand at random places for the vehicle to crash into. The
    ground under each stack is flattened into a small pad, so the stacks start
    out standing instead of sliding down a slope.

    The ground can be changed while driving: E raises a mound in front of the
    vehicle and Q digs a hollow. Only the regions that change are rebuilt.

    Collision follows Terrain3D's dynamic mode: only the ground near the
    vehicle can be collided with, using small collision pieces that move as
    the vehicle does. So the rain falls near the vehicle, and anything that
    rolls far enough away falls through the ground and is removed.
*/
class DriveOpen is Game
    WorldTerrain terrain
    Model chassis
    Vehicle vehicle
    VehicleMovementBehavior movement
    PerlinNoise noise
    BitwiseOperations ops
    InputMonitor monitor
    KeyboardEvent keys
    Math math

    // How many height samples run along each side of the terrain, and how far
    // apart they are in the world. 512 samples half a unit apart make a square
    // 256 units across, with triangles small enough that the wheels follow the
    // ground closely.
    integer mapSize = 512
    number terrainScale = 0.5

    // How many samples run along each side of one terrain region. Regions of
    // 64 samples are 32 units across, so the map is 8 by 8 regions, and the
    // vehicle crosses from one region to the next every few seconds. That
    // tests that the regions' collision shapes work together.
    integer regionSize = 64

    // How far apart, in world units, the ground's texture repeats.
    number textureRepeat = 4

    // Changing the ground while driving. Holding E raises, and holding Q
    // lowers, a circle editRadius across, centered editAhead units in front
    // of the vehicle, by editAmount every editInterval seconds. Each change
    // rebuilds the regions it touches. The renderer can't free the old
    // meshes yet, so each change uses a little more memory.
    number editRadius = 4
    number editAhead = 7
    number editAmount = 0.4
    number editInterval = 0.15
    number timeUntilEdit = 0

    // Collision. While dynamicCollision is true, only the ground within
    // collisionRadius samples of the vehicle can be collided with, using
    // pieces collisionShapeSize samples across, as in Terrain3D's dynamic
    // mode. Terrain3D's default radius is 64 samples; 96 here is 48 units,
    // so every box stack starts on ground. While it is false, every region
    // has a collision shape for its whole area, as before.
    boolean dynamicCollision = true
    integer collisionRadius = 96
    integer collisionShapeSize = 16

    // How far from the vehicle the rain falls, in world units, while
    // collision is dynamic.
    number rainRadius = 20
    integer lastPieceCount = -1

    // Streaming. While streamTerrain is true, the whole world is saved to
    // saveFolder at the start, then only the regions near the vehicle are
    // loaded from it, and those within drawRadius world units are drawn.
    // Regions load and unload a few at a time as the vehicle drives, and
    // ones changed with E or Q are saved before they unload, so the change
    // is still there when the vehicle comes back. The render tree check
    // isn't told about streamed region models.
    boolean streamTerrain = true
    number drawRadius = 40

    // Distant terrain. While streaming, regions past drawRadius and within
    // farRadius world units are drawn with less detail: a vertex every
    // farStep samples instead of every sample. 200 reaches every corner of
    // the map from its middle. Set farRadius to 0 to draw nothing past
    // drawRadius.
    number farRadius = 200
    integer farStep = 4

    // How far the far models' skirts hang down, in world units. Taller hills
    // can leave larger cracks where a far region meets a full one, so the
    // skirts are deeper than the default of 1.
    number farSkirtDepth = 6

    // While tintFarTerrain is true, far models are drawn tinted red, so it is
    // easy to see which regions are drawn with less detail, and to watch
    // them change to full detail as the vehicle comes near.
    boolean tintFarTerrain = true

    // Texture splatting. While useSplatting is true, the ground is drawn with
    // four textures blended by splat weights: grass (red) on flat ground,
    // rock (green) on slopes, dirt (blue) on the box stacks' pads, and sand
    // (alpha) in the low valleys. The weights start out by slope, between
    // rockLowDegrees and rockHighDegrees, and sand where the ground is below
    // sandHeight. P paints the current layer in front of the vehicle, and C
    // changes which layer that is. Each texture tile covers layerRepeat
    // world units. The dirt and sand textures are made here, so no image
    // files are needed for them.
    //
    // Only the terrain's models are drawn with the splat shader; everything
    // else keeps the default one. While splatting, the far tint isn't shown.
    boolean useSplatting = true
    // Whether grass and rock are drawn from AmbientCG texture sets, with
    // bumps and height blending, rather than plain textures.
    boolean useTextureSets = true
    // Whether the texture sets use their original 16-bit normal and height
    // maps (each set's Original16bit folder) instead of the 8-bit copies.
    // The 16-bit files need the updated native image loader (stb_image 2.29).
    boolean useOriginal16BitTextures = true

    // The sky (library item 26, Item26.md): a daytime sky made by
    // Skyboxes/MakeDaySky.py, behind everything. K hides or shows it, to
    // compare with no sky.
    boolean useSkybox = true
    text skyboxFolder = "Skyboxes/Day/"
    Skybox skybox
    boolean skyShown = false
    boolean kWasDown = false

    // Headlights: two spotlights placed at the front of the car every frame
    // (SpotlightPlan.md, Item 37). H switches them on and off, and N switches
    // between day and night, so they are easy to see. They aren't children
    // of the chassis, since its 152 times scale would scale their placement.
    SpotLight leftHeadlight
    SpotLight rightHeadlight
    boolean headlightsOn = true
    boolean hWasDown = false
    boolean night = false
    boolean nWasDown = false
    number daySunIntensity = 2.5
    number nightSunIntensity = 0.08
    number layerRepeat = 6

    // Seconds until the next GPU memory report (MemoryPlan.md).
    number timeUntilMemoryReport = 5
    TerrainSplatShaderProgram splatProgram = undefined
    number rockLowDegrees = 12
    number rockHighDegrees = 22
    number sandHeight = 8
    integer paintLayer = 2
    number paintStrength = 0.5
    number timeUntilLayerChange = 0
    boolean splatReadyReported = false

    // Whether paint has been put down since the splat texture was last made.
    // The texture is made again only when P is let go, since each new one
    // uses up one of the renderer's texture places.
    boolean paintPending = false
    TextureSplat groundLayers

    // Save check. While checkSaving is true, the terrain is saved to the
    // folder saveFolder once it is built, loaded back into new TerrainData,
    // and every sample is compared. The result is written to the console.
    boolean checkSaving = true
    text saveFolder = "SavedTerrain"

    // How tall the highest possible ground is before the terrain is scaled.
    // The noise mostly stays in the middle of its range, so the hills in
    // practice rise and fall well short of this around the middle height.
    // It was 24, which made hills only a few units tall. 80 makes them tall
    // enough to see in the distance.
    number heightScale = 80

    // How often the hills repeat, per sample. How steep the hills are
    // depends on their height times this. It was 0.0125 (a hill about every
    // 40 units). 0.005 is a hill about every 100 units, so with the taller
    // hills the slopes are only a little steeper than before, and the
    // vehicle can still climb them.
    number hillFrequency = 0.005

    // Where the terrain's corner sits. The terrain is centered on the origin
    // and lowered so its middle height is close to 0. The corner must be a
    // whole number of samples from the origin, since the terrain's samples
    // are counted from there.
    number baseX = -128
    number baseY = -6
    number baseZ = -128

    // How far above the ground the chassis center is placed when the vehicle
    // is reset. The wheels reach 1.1 units below the chassis center at rest,
    // so a little more than that drops it gently onto its wheels.
    number dropHeight = 1.4

    // The chase camera sits this far behind the vehicle along its facing,
    // and this far above it (Camera:Follow).
    number cameraBehind = 12
    number cameraAbove = 5

    // The rain of balls. A new ball falls every dropInterval seconds, from
    // dropHeightAbove units over the highest possible ground, at a random place
    // over the terrain. No more than maximumDrops are in the scene at once.
    // Once the limit is reached, the oldest ball is picked up and dropped
    // again, so the rain keeps falling.
    Array<Model> drops
    Random random
    integer maximumDrops = 200
    number dropInterval = 0.05
    number timeUntilDrop = 0
    number dropDiameter = 0.2
    number dropHeightAbove = 10

    // The box stacks. Each stack is stackSize boxes along each side and
    // stackSize boxes tall, and each box is boxSize along each side. The
    // stacks are placed at random, but the same places every run, at least
    // stackClearance from the vehicle's starting point and from each other,
    // and no more than stackReach from the center of the map.
    // The ground is flat within padRadius of a stack's center, and blends back
    // into the hills over the next padBlend units.
    Array<Vector3> stackSites
    Random siteRandom
    PhysicsProperties3D stackProperties
    integer stackCount = 6
    integer stackSize = 5
    number boxSize = 0.5
    number stackClearance = 14
    number stackReach = 28
    number padRadius = 2.5
    number padBlend = 4

    // Benchmark mode, for comparing performance between builds. The vehicle
    // is not driven, the rain uses a fixed seed and a fixed time per frame,
    // so every run does the same work frame by frame. After benchmarkFrames
    // frames the results are written to the console and the game closes,
    // which also makes the profiler save its snapshot. The first warmupFrames
    // frames are reported separately, since they include loading and the
    // Java compiler warming up.
    boolean benchmark = false
    integer benchmarkFrames = 1200
    integer warmupFrames = 300
    number benchmarkStep = 1.0 / 60.0
    integer benchmarkSeed = 1234
    integer frameCount = 0
    number firstFrameSeconds = 0
    number warmupSeconds = 0
    number measuredSeconds = 0
    number slowestFrameSeconds = 0

    // A ball this far past any edge of the terrain, or this far below its
    // base, has left the map and is removed.
    number edgeMargin = 5
    number fallLimit = 20

    // Sleep check. While sleepReport is true, a summary of how many boxes and
    // balls are asleep, awake but still, and moving is written to the console
    // every reportInterval seconds. Turn rain off for a clean check, since
    // falling balls wake whatever they land on.
    boolean sleepReport = false
    boolean rain = true
    number reportInterval = 2
    number timeUntilReport = 2
    Array<Model> boxes

    // The speeds at or below which the physics counts a body as still, in
    // units per second and radians per second. These match the sleeping
    // thresholds in CollisionGroup3D.
    number linearSleepSpeed = 0.8
    number angularSleepSpeed = 1
    FramesPerSecondLabel fpsLabel
    Label cullLabel

    // Render tree check. While useRenderTree is true, every drawn item is
    // added to a RenderTree3D as well as to the game. Each frame the tree is
    // asked what the camera and the sun's shadows can see, and every
    // renderCheckInterval frames its answers are checked by testing every
    // item by hand. Drawing does not change. Every renderSnapshotInterval
    // frames, the console shows how many items are in the tree and how many
    // would be drawn from where the camera is then. A summary of the whole
    // run is written at the end of a benchmark. See RenderTreeCheck.
    // While renderTreeMovesAll is true, the tree is told every item moved,
    // every frame. Otherwise it is only told about items whose physics is
    // awake, and the wheels.
    // While addPointLight is true, a point light hangs over the middle of
    // the map, so the tree is also asked what is within its reach.
    boolean useRenderTree = false
    integer renderCheckInterval = 10
    boolean renderTreeMovesAll = false
    boolean addPointLight = true
    integer renderSnapshotInterval = 200

    // Which kind of render tree to test: 0 for DynamicVolumeRenderTree3D, 1 for
    // QuadTree3D, 2 for Octree3D. The quadtree and octree cover the terrain, with
    // room above it for the rain and around it for things that roll off.
    integer renderTreeKind = 0

    // How far from the camera objects are drawn into the sun's shadows when
    // the layer culls, or 0 for the sun to work it out from its shadow
    // cascades. The map is 128 units across. It is set on the sun, with
    // DirectionalLight:SetCullingRange, and the layer reads it from there. It
    // changes only what is drawn into the shadows, not the painter's
    // cascades.
    number sunCullingRange = 20

    // If more than 0, the camera's far plane, in place of the default 100
    // that PerspectiveCamera sets. The painter fits its shadow cascades
    // between the camera's near and far planes, so this also changes the
    // cascades, which is the closest this game can come to a real shadow
    // distance without changing the library. Anything farther away is not
    // drawn at all. While distant terrain is on and this is 0, the far
    // plane is set past the far radius instead, so the distance can be seen.
    number cameraFarDistance = 0
    RenderTreeCheck renderCheck
    DirectionalLight sunlight
    PointLight lamp = undefined

    action Main
        // Terrain currently builds its mesh with the Vulkan renderer only.
        
        DesktopConfiguration desk = GetDesktopConfiguration()
        desk:resizable = true
        SetMultisampling(4)
        SetScreenSize(1000, 500)
        //SetFullScreen(true)
        
        UseVulkan(true)
        StartGame()
    end

    action CreateGame
        // The splat shader is compiled here, before the first frame, so the
        // first frame that draws terrain doesn't stall to compile it.
        if useSplatting and streamTerrain
            TerrainSplatShaderProgram program
            program:InstallAsProgram(layerRepeat)
            splatProgram = program
            output "Splat shader compiled for the terrain's models: " + program:IsCompiled()
        end

        if cameraFarDistance > 0
            GetCamera3D():SetFar(cameraFarDistance)
        elseif streamTerrain and farRadius > 0
            // The camera sits cameraBehind units behind the vehicle, so the
            // far plane reaches a little past the far radius from there.
            GetCamera3D():SetFar(farRadius + cameraBehind + 20)
        end

        cullLabel:SetText("0% Culled")
        Add(cullLabel)
        EnablePhysics3D(true)
        SetGravity3D(0, -9.8, 0)
        Color colors

        if benchmark
            random:SetSeed(benchmarkSeed)
        end

        if renderTreeMovesAll
            renderCheck:SetMovedChoice(renderCheck:MOVED_ALL)
        end
        renderCheck:SetCheckInterval(renderCheckInterval)
        renderCheck:SetSnapshotInterval(renderSnapshotInterval)
        if renderTreeKind = 1
            QuadTree3D quadtree
            quadtree:SetRegion(-140, -40, -140, 140, 80, 140)
            renderCheck:SetTree(quadtree)
        elseif renderTreeKind = 2
            Octree3D octree
            octree:SetRegion(-140, -40, -140, 140, 80, 140)
            renderCheck:SetTree(octree)
        end

        sunlight:SetIntensity(2.5)
        sunlight:SetColor(colors:LightGray())
        sunlight:SetDirection(-1, -4, 2)
        sunlight:SetCullingRange(sunCullingRange)
        Add(sunlight)

        if useSkybox
            skybox:Load(skyboxFolder + "right.png", skyboxFolder + "left.png", skyboxFolder + "top.png",
                skyboxFolder + "bottom.png", skyboxFolder + "front.png", skyboxFolder + "back.png")
            SetSkybox(skybox)
            skyShown = true
            output "Sky: loaded from " + skyboxFolder + ". K hides or shows it."
        end

        // The stack sites are chosen first, because the terrain flattens the
        // ground under them while it is built.
        ChooseStackSites()
        BuildTerrain()
        BuildStacks()
        BuildChassis()
        BuildVehicle()
        ResetVehicle()
        BuildHeadlights()
        // The camera chases the chassis, placed by the library each frame
        // after the physics, when the vehicle is where it will be drawn.
        GetCamera3D():Follow(chassis, cameraBehind, cameraAbove)
        Add(fpsLabel)

        if addPointLight
            PointLight light
            light:SetColor(colors:CustomColor(0.5, 0.5, 1, 1))
            light:SetIntensity(50)
            light:SetCullingRange(5)
            light:SetPosition(0, GetGroundHeightAt(0, 0) + 9, 0)
            Add(light)
            lamp = light
        end

        if benchmark
            // Nobody drives during a benchmark, so every run is the same.
            movement:SetActive(false)
        end
    end

    action Update(number seconds)
        // Every five seconds, the GPU memory in use (MemoryPlan.md).
        timeUntilMemoryReport = timeUntilMemoryReport - seconds
        if timeUntilMemoryReport <= 0
            timeUntilMemoryReport = 5
            GameStateManager memoryState
            if memoryState:GetGameGraphics() is VulkanGraphics
                VulkanGraphics memoryGraphics = cast(VulkanGraphics, memoryState:GetGameGraphics())
                output memoryGraphics:GetMemoryReport()
            end
        end

        cullLabel:SetPosition(fpsLabel:GetX() + fpsLabel:GetWidth() + 20, fpsLabel:GetY())
        Layer3D layer = GetCurrentLayer3D()
        number cull = 100 * layer:GetCullPercentage()
        text cullText = "" + cull
        integer value = cullText:IndexOf(".")
        cullText = cullText:GetSubtext(0, value + 2)
        cullLabel:SetText("Culled: " + cullText + " %")
        if benchmark
            RecordFrame(seconds)
            if frameCount >= benchmarkFrames
                ReportBenchmark()
                Exit()
                return now
            end
        end

        boolean kDown = monitor:IsKeyPressed(keys:K)
        if useSkybox and kDown and not kWasDown
            ToggleSky()
        end
        kWasDown = kDown

        boolean hDown = monitor:IsKeyPressed(keys:H)
        if hDown and not hWasDown
            SetHeadlights(not headlightsOn)
        end
        hWasDown = hDown

        boolean nDown = monitor:IsKeyPressed(keys:N)
        if nDown and not nWasDown
            night = not night
            if night
                sunlight:SetIntensity(nightSunIntensity)
                output "Night: the sun is dimmed. K hides the sky for a dark background."
            else
                sunlight:SetIntensity(daySunIntensity)
                output "Day."
            end
        end
        nWasDown = nDown

        if monitor:IsKeyPressed(keys:R)
            ResetVehicle()
        end

        // Keep the terrain's regions, and its collision, around the vehicle.
        if terrain:Update(GetCurrentLayer3D(), chassis:GetX(), chassis:GetZ())
            ReportTerrainChanges()
        end

        timeUntilEdit = timeUntilEdit - seconds
        if timeUntilEdit <= 0
            if monitor:IsKeyPressed(keys:E)
                EditGroundAhead(editAmount)
                timeUntilEdit = editInterval
            elseif monitor:IsKeyPressed(keys:Q)
                EditGroundAhead(-editAmount)
                timeUntilEdit = editInterval
            elseif useSplatting and streamTerrain and monitor:IsKeyPressed(keys:P)
                PaintGroundAhead()
                timeUntilEdit = editInterval
            end
        end

        if paintPending and not monitor:IsKeyPressed(keys:P)
            FinishPainting()
        end

        timeUntilLayerChange = timeUntilLayerChange - seconds
        if useSplatting and timeUntilLayerChange <= 0 and monitor:IsKeyPressed(keys:C)
            paintLayer = (paintLayer + 1) mod 4
            output "Painting layer: " + GetLayerName(paintLayer)
            timeUntilLayerChange = 0.3
        end

        if useSplatting and streamTerrain and not splatReadyReported and terrain:AreLayersReady()
            output "Splat textures are ready; the ground is now splatted."
            splatReadyReported = true
            ReportTextureGroups()
        end

        // Driving off the edge of the map drops the vehicle into nothing, so
        // bring it back once it has fallen well below the lowest ground.
        if chassis:GetY() < baseY - fallLimit
            ResetVehicle()
        end

        // In a benchmark, the rain advances by a fixed time each frame, so
        // the same balls fall on the same frames no matter how fast it runs.
        number rainSeconds = seconds
        if benchmark
            rainSeconds = benchmarkStep
        end
        if rain
            UpdateRain(rainSeconds)
        end

        if sleepReport
            timeUntilReport = timeUntilReport - seconds
            if timeUntilReport <= 0
                ReportSleep()
                timeUntilReport = reportInterval
            end
        end
        if useRenderTree
            renderCheck:Update(GetCamera3D(), sunlight, lamp)
        end
    end

    /*
    This action adds an item to the game and, while useRenderTree is true,
    to the render tree as well.

    Attribute: Parameter item The item to add.
    Attribute: Parameter isStatic True if the item is not expected to move.
    Attribute: Parameter alwaysMoves True if the item moves without physics,
    so the tree is told it moved every frame.
    */
    action AddToBoth(Item3D item, boolean isStatic, boolean alwaysMoves)
        Add(item)
        if useRenderTree
            renderCheck:Add(item, isStatic, alwaysMoves)
        end
    end

    /*
    This action removes an item from the game and from the render tree.
    */
    action RemoveFromBoth(Item3D item)
        Remove(item)
        if useRenderTree
            renderCheck:Remove(item)
        end
    end

    /*
    This action records how long one frame took. The first frame is kept
    apart, since it includes everything that happened while the game loaded.
    */
    action RecordFrame(number seconds)
        if frameCount = 0
            firstFrameSeconds = seconds
        elseif frameCount < warmupFrames
            warmupSeconds = warmupSeconds + seconds
        else
            measuredSeconds = measuredSeconds + seconds
            if seconds > slowestFrameSeconds
                slowestFrameSeconds = seconds
            end
        end
        frameCount = frameCount + 1
    end

    /*
    This action writes the benchmark results to the console.
    */
    action ReportBenchmark
        integer warmupCount = warmupFrames - 1
        integer measuredCount = frameCount - warmupFrames

        output "Benchmark finished after " + frameCount + " frames."
        output "  First frame: " + math:Round(firstFrameSeconds * 1000, 1) + " ms"
        if warmupCount > 0
            output "  Warm-up, " + warmupCount + " frames: " + math:Round(warmupSeconds, 2) + " s, average "
                + math:Round(1000 * warmupSeconds / warmupCount, 2) + " ms per frame"
        end
        if measuredCount > 0
            output "  Measured, " + measuredCount + " frames: " + math:Round(measuredSeconds, 2) + " s, average "
                + math:Round(1000 * measuredSeconds / measuredCount, 2) + " ms per frame ("
                + math:Round(measuredCount / measuredSeconds, 1) + " frames per second)"
            output "  Slowest measured frame: " + math:Round(slowestFrameSeconds * 1000, 1) + " ms"
        end
        if useRenderTree
            renderCheck:Report()
        end
    end

    /*
    This action writes one line for the boxes and one for the balls, saying
    how many are asleep, how many are awake but still, and how many are moving.
    */
    action ReportSleep
        output "Boxes: " + DescribeSleep(boxes)
        output "Balls: " + DescribeSleep(drops)
    end

    /*
    This action counts how many of the given items are asleep, awake but
    still, and moving, along with the fastest speed and spin among the awake
    ones.
    */
    action DescribeSleep(Array<Model> items) returns text
        integer asleep = 0
        integer still = 0
        integer moving = 0
        number fastest = 0
        number fastestSpin = 0

        integer i = 0
        repeat while i < items:GetSize()
            Model item = items:Get(i)
            if not item:IsSimulated()
                asleep = asleep + 1
            else
                number speed = item:GetLinearVelocity():Length()
                number spin = item:GetAngularVelocity():Length()
                if speed <= linearSleepSpeed and spin <= angularSleepSpeed
                    still = still + 1
                else
                    moving = moving + 1
                end
                if speed > fastest
                    fastest = speed
                end
                if spin > fastestSpin
                    fastestSpin = spin
                end
            end
            i = i + 1
        end

        return items:GetSize() + " total, " + asleep + " asleep, " + still + " awake but still, "
            + moving + " moving (fastest awake: " + math:Round(fastest, 2) + " units/s, "
            + math:Round(fastestSpin, 2) + " rad/s)"
    end

    /*
    This action drops new balls at a steady rate and removes any that have
    left the map.
    */
    action UpdateRain(number seconds)
        RemoveLostDrops()

        timeUntilDrop = timeUntilDrop - seconds
        repeat while timeUntilDrop <= 0
            DropBall()
            timeUntilDrop = timeUntilDrop + dropInterval
        end
    end

    /*
    This action drops one ball. While there is room under the limit it makes
    a new ball. Once the limit is reached it reuses the oldest ball instead,
    moving it to the back of the list as the newest.
    */
    action DropBall
        Model ball = undefined
        if drops:GetSize() < maximumDrops
            ball = MakeBall()
            AddToBoth(ball, false, false)
        else
            ball = drops:RemoveFromFront()
        end
        drops:Add(ball)

        // A random place over the terrain, kept a little in from the edges,
        // high above the tallest possible hill. With dynamic collision, only
        // the ground near the vehicle can catch it, so it falls within
        // rainRadius of the vehicle.
        number size = (mapSize - 1) * terrainScale
        number x = baseX + 1 + random:RandomNumber() * (size - 2)
        number z = baseZ + 1 + random:RandomNumber() * (size - 2)
        if dynamicCollision
            x = math:Clamp(chassis:GetX() + (2 * random:RandomNumber() - 1) * rainRadius, baseX + 1, baseX + size - 1)
            z = math:Clamp(chassis:GetZ() + (2 * random:RandomNumber() - 1) * rainRadius, baseZ + 1, baseZ + size - 1)
        end
        number y = baseY + heightScale * terrainScale + dropHeightAbove

        Vector3 stop
        ball:SetPosition(x, y, z)
        ball:SetLinearVelocity(stop)
        ball:SetAngularVelocity(stop)
        ball:Simulate(true)
    end

    /*
    This action makes a ball that responds fully to physics: it falls, rolls,
    bounces, and pushes other objects, including the vehicle.
    */
    action MakeBall returns Model
        Color color
        Model ball
        //ball:LoadBox(dropDiameter, dropDiameter, dropDiameter, color:CustomColor(0.3 + 0.7 * random:RandomNumber(), 0.3 + 0.7 * random:RandomNumber(), 0.3 + 0.7 * random:RandomNumber(), 1))
        ball:LoadSphere(dropDiameter, dropDiameter, dropDiameter, color:CustomColor(0.3 + 0.7 * random:RandomNumber(), 0.3 + 0.7 * random:RandomNumber(), 0.3 + 0.7 * random:RandomNumber(), 1))
        ball:EnablePhysics(true)
        ball:SetResponsive()
        ball:SetMass(1)
        ball:SetRestitution(0.3)
        ball:SetFriction(0.5)
        // A little damping, since there is no rolling friction and a ball
        // that reaches flat ground would otherwise roll forever.
        ball:SetLinearDamping(0.05)
        ball:SetAngularDamping(0.2)
        ball:SetName("Rain Ball")
        return ball
    end

    /*
    This action removes every ball that has gone past an edge of the terrain
    or fallen far below it. It walks the list backward so removing a ball does
    not skip the one after it.
    */
    action RemoveLostDrops
        number size = (mapSize - 1) * terrainScale
        number lowX = baseX - edgeMargin
        number highX = baseX + size + edgeMargin
        number lowZ = baseZ - edgeMargin
        number highZ = baseZ + size + edgeMargin
        number lowY = baseY - fallLimit

        integer i = drops:GetSize() - 1
        repeat while i >= 0
            Model ball = drops:Get(i)
            if ball:GetX() < lowX or ball:GetX() > highX or ball:GetZ() < lowZ or ball:GetZ() > highZ or ball:GetY() < lowY
                drops:RemoveAt(i)
                RemoveFromBoth(ball)
            end
            i = i - 1
        end
    end

    /*
    This action builds the terrain from a generated height map. The map is
    imported into the terrain's data, which splits it into regions, and then
    each region gets a model with a mesh and a physics shape, so the
    vehicle's wheel rays have ground to land on.
    */
    action BuildTerrain
        TerrainData data = terrain:GetData()
        data:SetRegionSize(regionSize)
        data:SetVertexSpacing(terrainScale)

        // The terrain counts samples from the world's origin, so the map's
        // first pixel goes at the sample under its corner. Each height from 0
        // to 1 becomes heightScale * terrainScale units tall, starting at
        // baseY, the same heights the old Terrain gave.
        integer startX = cast(integer, baseX / terrainScale)
        integer startZ = cast(integer, baseZ / terrainScale)
        data:ImportHeightMap(GenerateHeightMap(), startX, startZ, heightScale * terrainScale, baseY)
        CheckImport(startX, startZ)
        if useSplatting and streamTerrain
            GenerateSplat(startX, startZ)
        end

        terrain:SetName("AllTerrainVehicle Hills")
        terrain:SetTexture("Textures/grass.png")
        terrain:SetTextureRepeat(textureRepeat)
        terrain:SetFriction(1)
        if dynamicCollision
            terrain:SetCollisionMode(terrain:COLLISION_DYNAMIC)
            TerrainCollision collision = terrain:GetCollision()
            collision:SetRadius(collisionRadius)
            collision:SetShapeSize(collisionShapeSize)
        else
            terrain:SetCollisionMode(terrain:COLLISION_FULL)
        end
        output "Terrain: " + data:GetRegionCount() + " regions."
        if checkSaving
            CheckSaving()
        end

        if streamTerrain
            // The whole world is saved, then streamed back from the files,
            // starting around the middle of the map where the vehicle starts.
            // CheckSaving has already saved it, if it ran.
            File folder
            folder:SetPath(saveFolder)
            if not checkSaving
                data:Save(folder)
            end
            if useSplatting
                terrain:SetTextureSplat(MakeGroundLayers())
                if useTextureSets
                    UseGroundTextureSets()
                end
                terrain:SetSplatProgram(splatProgram)
            end
            terrain:SetDrawRadius(drawRadius)
            terrain:SetFarRadius(farRadius)
            terrain:SetFarStep(farStep)
            terrain:SetSkirtDepth(farSkirtDepth)
            if tintFarTerrain
                Color tint
                terrain:SetFarTint(tint:CustomColor(1, 0.55, 0.55, 1))
            end
            terrain:StartStreaming(folder, GetCurrentLayer3D(), 0, 0)
            output "Streaming: " + data:GetRegionCount() + " regions loaded, " + terrain:GetRegionModelCount() +
                " drawn in full, " + terrain:GetFarModelCount() + " drawn far, from " + folder:GetAbsolutePath()
        else
            terrain:Build()
            output "Terrain: " + terrain:GetRegionModelCount() + " region models."

            // Each region model gives the render tree its own bounds, with
            // GetRenderBounds, since its mesh starts at its corner, not its
            // center.
            integer i = 0
            repeat while i < terrain:GetRegionModelCount()
                AddToBoth(terrain:GetRegionModel(i), true, false)
                i = i + 1
            end
        end

        // The vehicle starts in the middle of the map, so collision starts
        // there, before the stacks and the vehicle are placed.
        if dynamicCollision
            terrain:Update(GetCurrentLayer3D(), 0, 0)
            output "Collision: dynamic, " + terrain:GetCollision():GetActivePieceCount() + " pieces near the start."
        end
    end

    /*
    This action checks that importing the height map put each height on the
    right sample. It works out what each height should be from the noise,
    the same way the map was made, and compares it with what the terrain's
    data holds. The corners of the map are checked, along with samples
    picked at random. The result is written to the console.

    Attribute: Parameter startX The sample along x where the map's first pixel went.
    Attribute: Parameter startZ The sample along z where the map's first pixel went.
    */
    action CheckImport(integer startX, integer startZ)
        TerrainData data = terrain:GetData()
        Random picker
        picker:SetSeed(99)

        integer checks = 0
        integer matches = 0
        integer i = 0
        repeat while i < 104
            integer column = 0
            integer row = 0
            if i = 1
                column = mapSize - 1
            elseif i = 2
                row = mapSize - 1
            elseif i = 3
                column = mapSize - 1
                row = mapSize - 1
            elseif i > 3
                column = picker:RandomIntegerBetween(0, mapSize - 1)
                row = picker:RandomIntegerBetween(0, mapSize - 1)
            end

            // The map stores each height as a level out of 65536, so the
            // expected height is rounded the same way.
            integer level = EncodeHeight(GetHeightAtSample(column, row))
            number expected = baseY + level / 65536.0 * heightScale * terrainScale
            number actual = data:GetSampleHeight(startX + column, startZ + row)
            checks = checks + 1
            if math:AbsoluteValue(actual - expected) < 0.00001
                matches = matches + 1
            elseif checks - matches <= 5
                output "Import check: sample (" + column + ", " + row + ") expected " + expected + " but found " + actual
            end
            i = i + 1
        end
        output "Import check: " + matches + " of " + checks + " samples match."
    end

    /*
    This action builds the height map, one sample at a time, from the noise.
    */
    action GenerateHeightMap returns PixelMap
        PixelMap map
        Format format
        format:SetValue(format:RGBA8888)
        map:CreatePixelMap(mapSize, mapSize, format)

        integer row = 0
        repeat while row < mapSize
            integer column = 0
            repeat while column < mapSize
                // Terrain reads the row as a z position and the column as an x
                // position, so the pixels are written in that order.
                number height = GetHeightAtSample(column, row)
                map:SetPixel(row, column, PackHeight(EncodeHeight(height)))
                column = column + 1
            end
            row = row + 1
        end

        return map
    end

    /*
    This action returns the height of the ground at a sample position, from 0
    to 1.
    */
    action GetHeightAtSample(number sampleX, number sampleZ) returns number
        number height = GetHillHeight(sampleX, sampleZ)

        // Flatten the ground near any stack. Inside the pad the ground is the
        // pad's height. Past it, the ground eases back into the hills, using a
        // smooth curve so there is no sharp edge for the wheels to catch.
        number worldX = baseX + sampleX * terrainScale
        number worldZ = baseZ + sampleZ * terrainScale
        integer i = 0
        repeat while i < stackSites:GetSize()
            Vector3 site = stackSites:Get(i)
            number dx = worldX - site:GetX()
            number dz = worldZ - site:GetZ()
            number distance = math:SquareRoot(dx * dx + dz * dz)
            if distance < padRadius
                return site:GetY()
            elseif distance < padRadius + padBlend
                number t = (distance - padRadius) / padBlend
                number blend = t * t * (3 - 2 * t)
                height = site:GetY() + (height - site:GetY()) * blend
            end
            i = i + 1
        end
        return height
    end

    /*
    This action returns the height of the hills at a sample position, from 0
    to 1, before any ground is flattened for the stacks.
    */
    action GetHillHeight(number sampleX, number sampleZ) returns number
        return noise:ToUnitRange(noise:GetAdditiveNoise(sampleX, sampleZ))
    end

    /*
    This action picks where the box stacks stand. It tries random places in a
    ring around the center of the map, between stackClearance and stackReach
    from the vehicle's starting point, keeping ones that are away from the
    other stacks. Each site stores the height of
    the hills at its center, from 0 to 1, as its y value. That is the height
    its pad is flattened to.
    */
    action ChooseStackSites
        // Rolling hills, hillFrequency apart, with three finer layers of
        // bumps laid over them. This is set up here because choosing the
        // sites already needs the height of the hills.
        noise:SetSeed(2026)
        noise:SetFrequency(hillFrequency)
        noise:SetOctaves(4)
        siteRandom:SetSeed(7)

        integer attempts = 0
        repeat while stackSites:GetSize() < stackCount and attempts < 500
            number angle = siteRandom:RandomNumber() * 2 * math:pi
            number reach = stackClearance + siteRandom:RandomNumber() * (stackReach - stackClearance)
            number x = reach * math:Cosine(angle)
            number z = reach * math:Sine(angle)

            boolean fits = true
            integer i = 0
            repeat while fits and i < stackSites:GetSize()
                Vector3 other = stackSites:Get(i)
                number dx = x - other:GetX()
                number dz = z - other:GetZ()
                if math:SquareRoot(dx * dx + dz * dz) < stackClearance
                    fits = false
                end
                i = i + 1
            end

            if fits
                Vector3 site
                site:Set(x, GetHillHeight((x - baseX) / terrainScale, (z - baseZ) / terrainScale), z)
                stackSites:Add(site)
            end
            attempts = attempts + 1
        end
    end

    /*
    This action builds a stack of boxes on each pad. The boxes respond fully
    to physics, so the vehicle can knock them over and scatter them.
    */
    action BuildStacks
        stackProperties:SetResponsiveness(stackProperties:RESPONSIVE)
        stackProperties:SetFriction(0.5)
        stackProperties:SetRestitution(0.5)

        integer i = 0
        repeat while i < stackSites:GetSize()
            Vector3 site = stackSites:Get(i)
            BuildStack(site:GetX(), GetGroundHeightAt(site:GetX(), site:GetZ()), site:GetZ())
            i = i + 1
        end
    end

    /*
    This action builds one stack of boxes, centered on the given point, with
    its lowest layer resting on the ground at the given height.
    */
    action BuildStack(number centerX, number groundY, number centerZ)
        Color color
        number start = -(stackSize - 1) * boxSize / 2

        integer level = 0
        repeat while level < stackSize
            integer row = 0
            repeat while row < stackSize
                integer column = 0
                repeat while column < stackSize
                    Model box
                    box:LoadBox(boxSize, boxSize, boxSize, color:CustomColor(random:RandomNumber(), random:RandomNumber(), random:RandomNumber(), 1))
                    box:SetPosition(centerX + start + column * boxSize, groundY + boxSize / 2 + level * boxSize, centerZ + start + row * boxSize)
                    box:EnablePhysics(true)
                    box:SetPhysicsProperties(stackProperties)
                    box:Simulate(false)
                    box:SetName("Stack Box")
                    AddToBoth(box, true, false)
                    boxes:Add(box)
                    column = column + 1
                end
                row = row + 1
            end
            level = level + 1
        end
    end

    /*
    This action writes to the console what the terrain's last update did:
    regions loaded, unloaded and saved while streaming, and how many
    collision pieces are near the vehicle. Nothing is written for an update
    that only moved region models in or out of the layer.
    */
    action ReportTerrainChanges
        text report = ""
        if streamTerrain
            TerrainStreamer streamer = terrain:GetStreamer()
            integer loaded = streamer:GetLastLoadedCount()
            integer unloaded = streamer:GetLastUnloadedCount()
            integer saved = streamer:GetLastSavedCount()
            if loaded > 0 or unloaded > 0
                report = "Streaming: loaded " + loaded + ", unloaded " + unloaded + ", saved " + saved + "; " +
                    terrain:GetData():GetRegionCount() + " regions loaded, " + terrain:GetRegionModelCount() + " drawn in full, " +
                    terrain:GetFarModelCount() + " drawn far. "
            end
        end
        if dynamicCollision
            integer pieces = terrain:GetCollision():GetActivePieceCount()
            if pieces not= lastPieceCount
                report = report + "Collision pieces near the vehicle: " + pieces
                lastPieceCount = pieces
            end
        end
        if report not= ""
            output report
        end
    end

    /*
    This action returns how high the ground is at a position in the world. It
    asks the terrain, which follows the same triangles that are drawn and
    that the physics uses, so things placed here rest right on the ground.
    The terrain must have been built first.
    */
    action GetGroundHeightAt(number worldX, number worldZ) returns number
        return terrain:GetData():GetSurfaceHeight(worldX, worldZ)
    end

    /*
    This action returns the direction the vehicle faces, flattened so it is
    level, as a vector one unit long.
    */
    action GetHeading returns Vector3
        // The vehicle drives along its own z axis, the third column of its
        // rotation, as it is drawn. Only the level part of that direction is
        // used.
        Matrix3 basis = chassis:GetDrawnTransform():GetBasis()
        Vector3 forward = basis:GetColumn(2)
        number faceX = forward:GetX()
        number faceZ = forward:GetZ()
        number flat = math:SquareRoot(faceX * faceX + faceZ * faceZ)
        Vector3 heading
        if flat < 0.0001
            // Pointing straight up or down, so there is no heading. Any fixed
            // direction works until the vehicle levels out again.
            heading:Set(0, 0, 1)
        else
            heading:Set(faceX / flat, 0, faceZ / flat)
        end
        return heading
    end

    /*
    This action gives the whole map its first splat weights: grass on flat
    ground and rock on slopes, blended between rockLowDegrees and
    rockHighDegrees; then sand where the ground is low, and dirt on the
    stacks' pads.

    Attribute: Parameter startX The map's first sample along x.
    Attribute: Parameter startZ The map's first sample along z.
    */
    action GenerateSplat(integer startX, integer startZ)
        TerrainData data = terrain:GetData()
        data:GenerateSplatBySlope(startX, startZ, mapSize, mapSize, 0, 1, rockLowDegrees, rockHighDegrees)

        // Sand in the valleys, fading in over the last 3 units below
        // sandHeight.
        integer z = startZ
        repeat while z < startZ + mapSize
            integer x = startX
            repeat while x < startX + mapSize
                number height = data:GetSampleHeight(x, z)
                number sand = math:Clamp((sandHeight - height) / 3, 0, 1)
                if sand > 0
                    integer code = data:GetSampleSplat(x, z)
                    number keep = 1 - sand
                    data:SetSampleSplat(x, z, data:PackSplat(data:GetSplatWeight(code, 0) * keep,
                        data:GetSplatWeight(code, 1) * keep, data:GetSplatWeight(code, 2) * keep,
                        data:GetSplatWeight(code, 3) * keep + sand))
                end
                x = x + 1
            end
            z = z + 1
        end

        // Dirt on the pads under the box stacks.
        integer i = 0
        repeat while i < stackSites:GetSize()
            Vector3 site = stackSites:Get(i)
            data:PaintSplat(site:GetX(), site:GetZ(), padRadius + padBlend, 2, 1)
            i = i + 1
        end
        data:ClearSplatEditedArea()
    end

    /*
    This action gives the grass and rock layers AmbientCG texture sets
    (library item 24): Ground037, mossy ground, for grass, and Rocks002,
    pebbles, for rock. They then have bumps, roughness and ambient
    occlusion, and blend with each other by height. Dirt and sand stay the
    plain speckled textures.
    */
    action UseGroundTextureSets
        Material grass
        grass:SetTextureSet("Textures/Ground037_1K-PNG", "Ground037_1K-PNG")
        if useOriginal16BitTextures
            UseOriginal16BitMaps(grass, "Textures/Ground037_1K-PNG", "Ground037_1K-PNG")
        end
        grass:SetTextureScale(3)
        terrain:SetLayerMaterial(0, grass)

        Material rock
        rock:SetTextureSet("Textures/Rocks002_1K-PNG", "Rocks002_1K-PNG")
        if useOriginal16BitTextures
            UseOriginal16BitMaps(rock, "Textures/Rocks002_1K-PNG", "Rocks002_1K-PNG")
        end
        rock:SetTextureScale(2.5)
        terrain:SetLayerMaterial(1, rock)
    end

    /*
    This action points a texture set's normal and height maps at the
    original 16-bit PNGs in the set's Original16bit folder, instead of the
    8-bit copies made when the native loader couldn't read 16-bit images.

    Attribute: Parameter material The material SetTextureSet filled.
    Attribute: Parameter folder The texture set's folder.
    Attribute: Parameter name The texture set's name.
    */
    action UseOriginal16BitMaps(Material material, text folder, text name)
        text start = folder + "/Original16bit/" + name + "_"
        material:SetNormalMapPath(start + "NormalGL.png")
        material:SetNormalMapDirectX(false)
        material:SetHeightMapPath(start + "Displacement.png")
    end

    /*
    This action hides the sky, or shows it again, so the scene can be
    compared with and without it.
    */
    action ToggleSky
        if skyShown
            SetSkybox(undefined)
            skyShown = false
            output "Sky: hidden."
        else
            SetSkybox(skybox)
            skyShown = true
            output "Sky: shown."
        end
    end

    /*
    This action makes the four ground textures: grass and rock from files,
    and dirt and sand made here from colored noise.

    Attribute: Returns The four textures, as a TextureSplat.
    */
    action MakeGroundLayers returns TextureSplat
        Texture grass
        grass:LoadFromFile("Textures/grass.png", true)
        Texture rock
        rock:LoadFromFile("Textures/rock.png", true)
        groundLayers:SetRed(grass)
        groundLayers:SetGreen(rock)
        groundLayers:SetBlue(MakeSpeckledTexture(0.42, 0.31, 0.2, 0.25))
        groundLayers:SetAlpha(MakeSpeckledTexture(0.86, 0.78, 0.56, 0.12))
        return groundLayers
    end

    /*
    This action makes a small texture of one color with a random grain, so
    it reads as ground rather than a flat color. Random speckles tile
    without seams.

    Attribute: Parameter red The color's red, from 0 to 1.
    Attribute: Parameter green The color's green, from 0 to 1.
    Attribute: Parameter blue The color's blue, from 0 to 1.
    Attribute: Parameter grain How much lighter or darker a speckle can be, from 0 to 1.
    Attribute: Returns The texture.
    */
    action MakeSpeckledTexture(number red, number green, number blue, number grain) returns Texture
        PixelMap map
        Format format
        format:SetValue(format:RGBA8888)
        map:CreatePixelMap(64, 64, format)
        Random speckles
        speckles:SetSeed(42)
        Color color
        integer y = 0
        repeat while y < 64
            integer x = 0
            repeat while x < 64
                number shade = 1 + (2 * speckles:RandomNumber() - 1) * grain
                map:SetPixel(x, y, color:CustomColor(math:Clamp(red * shade, 0, 1), math:Clamp(green * shade, 0, 1),
                    math:Clamp(blue * shade, 0, 1), 1))
                x = x + 1
            end
            y = y + 1
        end
        Texture made
        // Mipmaps keep the speckles from shimmering in the distance.
        made:LoadFromPixelMap(map, map:GetFormat(), true)
        return made
    end

    /*
    This action writes to the console how the renderer has grouped the
    textures, to check whether the terrain's textures have pushed others,
    such as the car's, out of the first group. The renderer binds one group
    at a time, and its group size comes from the device's limits.
    */
    action ReportTextureGroups
        GameStateManager gameState
        VulkanGraphics graphics = cast(VulkanGraphics, gameState:GetGameGraphics())
        output "Texture check: " + graphics:GetMaxDescriptorsPerStage() + " textures per group."
        output "Texture check: ground layers at " + DescribeTexture(groundLayers:GetRed()) + ", " +
            DescribeTexture(groundLayers:GetGreen()) + ", " + DescribeTexture(groundLayers:GetBlue()) + ", " +
            DescribeTexture(groundLayers:GetAlpha())
        if terrain:GetRegionModelCount() > 0
            ModelResourcesVulkan resources = cast(ModelResourcesVulkan, terrain:GetRegionModel(0):GetResources())
            output "Texture check: a region's splat texture at " + DescribeTexture(resources:GetTexture())
        end

        ModelBlueprintVulkan carBlueprint = cast(ModelBlueprintVulkan, chassis:GetModelBlueprint())
        Array<MaterialVulkan> materials = carBlueprint:GetMaterials()
        text groups = ""
        integer i = 0
        repeat while i < materials:GetSize()
            groups = groups + " " + materials:Get(i):GetTextureGroupIndex()
            i = i + 1
        end
        output "Texture check: the car's " + materials:GetSize() + " materials are in texture groups" + groups
    end

    /*
    This action describes where a texture is in the renderer.

    Attribute: Parameter checked The texture.
    Attribute: Returns Its index and group, as text.
    */
    action DescribeTexture(Texture checked) returns text
        if checked = undefined
            return "(none)"
        end
        return "index " + checked:GetVulkanTextureIndex() + " group " + checked:GetVulkanTextureGroupIndex()
    end

    /*
    This action returns the name of a splat layer.

    Attribute: Parameter layer 0 for red, 1 green, 2 blue, 3 alpha.
    Attribute: Returns The name of the ground texture on that layer.
    */
    action GetLayerName(integer layer) returns text
        if layer = 0
            return "grass"
        elseif layer = 1
            return "rock"
        elseif layer = 2
            return "dirt"
        end
        return "sand"
    end

    /*
    This action paints the current layer onto the ground in a circle in
    front of the vehicle. Only the splat weights change here; the splat
    texture is made again by FinishPainting, when P is let go.
    */
    action PaintGroundAhead
        Vector3 heading = GetHeading()
        number x = chassis:GetX() + heading:GetX() * editAhead
        number z = chassis:GetZ() + heading:GetZ() * editAhead
        TerrainData data = terrain:GetData()
        if not data:HasHeight(x, z)
            return now
        end
        data:PaintSplat(x, z, editRadius, paintLayer, paintStrength)
        paintPending = true
    end

    /*
    This action makes the splat texture again after painting, so the paint
    shows. The renderer can't yet reuse a texture's place, so each new
    splat texture uses another one, and after about 25 the splat texture
    leaves the group of places the splat shader can use. A warning is
    written when that is close.
    */
    action FinishPainting
        terrain:Rebuild()
        paintPending = false
        integer made = terrain:GetSplatTextureCount()
        output "Painted " + GetLayerName(paintLayer) + "; splat textures made so far: " + made + "."
        if made >= 20
            output "Warning: the renderer can't reuse texture places yet, so after a few more strokes painting will stop showing properly."
        end
    end

    /*
    This action raises or lowers the ground in a circle in front of the
    vehicle, then rebuilds the regions that changed. The console shows where
    the change was and how many regions were rebuilt.

    Attribute: Parameter amount How much to raise the middle of the circle. A negative amount lowers it.
    */
    action EditGroundAhead(number amount)
        Vector3 heading = GetHeading()
        number x = chassis:GetX() + heading:GetX() * editAhead
        number z = chassis:GetZ() + heading:GetZ() * editAhead
        TerrainData data = terrain:GetData()
        if not data:HasHeight(x, z)
            return now
        end
        data:RaiseArea(x, z, editRadius, amount)
        integer rebuilt = terrain:Rebuild()
        output "Changed the ground at (" + math:Round(x, 1) + ", " + math:Round(z, 1) + "), rebuilt " + rebuilt + " regions. " +
            "Slope there: " + math:Round(data:GetSlope(x, z), 1) + " degrees. " +
            "Meshes so far: " + terrain:GetInPlaceBuildCount() + " updated in place, " + terrain:GetNewMeshBuildCount() + " new."
    end

    /*
    This action saves the terrain, loads it back into new TerrainData, and
    compares every sample, to check that saving and loading keep the
    heights. The saved file is kept in saveFolder. The result is written to
    the console.
    */
    action CheckSaving
        TerrainData data = terrain:GetData()
        File folder
        folder:SetPath(saveFolder)
        data:Save(folder)

        TerrainData loaded
        loaded:Load(folder)

        integer checks = 0
        integer missing = 0
        number largestDifference = 0
        integer i = 0
        repeat while i < data:GetRegionCount()
            TerrainRegion region = data:GetRegionAtIndex(i)
            TerrainRegion loadedRegion = loaded:GetRegion(region:GetLocationX(), region:GetLocationZ())
            if loadedRegion = undefined
                missing = missing + 1
            else
                integer z = 0
                repeat while z < regionSize
                    integer x = 0
                    repeat while x < regionSize
                        number difference = math:AbsoluteValue(region:GetHeight(x, z) - loadedRegion:GetHeight(x, z))
                        if difference > largestDifference
                            largestDifference = difference
                        end
                        checks = checks + 1
                        x = x + 1
                    end
                    z = z + 1
                end
            end
            i = i + 1
        end
        output "Save check: " + loaded:GetRegionCount() + " of " + data:GetRegionCount() + " regions loaded from " +
            folder:GetAbsolutePath() + ", " + missing + " missing. " + checks + " samples compared, largest difference " +
            largestDifference + "."
    end

    /*
    This action turns a height from 0 to 1 into the sixteen bits a height map
    can hold. Terrain reads it back as two bytes divided by 65536, so the top
    is 65535, and anything outside the range is limited rather than wrapped.
    */
    action EncodeHeight(number height) returns integer
        integer level = cast(integer, height * 65536)
        if level < 0
            level = 0
        end
        if level > 65535
            level = 65535
        end
        return level
    end

    /*
    This action packs a sixteen bit height into a pixel. Red holds the coarse
    byte and green the fine byte. Blue repeats the coarse byte so the map still
    looks like a height map if it is viewed as a picture.
    */
    action PackHeight(integer level) returns integer
        integer coarse = ops:ShiftRight(level, 8)
        integer fine = ops:And(level, 255)

        integer code = ops:ShiftLeft(coarse, 24)
        code = ops:Or(code, ops:ShiftLeft(fine, 16))
        code = ops:Or(code, ops:ShiftLeft(coarse, 8))
        return ops:Or(code, 255)
    end

    action BuildChassis
        // The ToyCar model (Car/ToyCarCentered.gltf) is a copy of
        // Car/ToyCar.gltf without the blanket the toy sits on, and with its
        // origin moved to the centre of the body's box, since a collision box
        // is centred on its item. Its wheels are part of the body, so they
        // are drawn but do not turn. The vehicle's wheels are invisible rays.
        chassis:Load("Car/ToyCarCentered.gltf")

        // The toy is about 4 cm long. This scale makes its wheels 0.4 in
        // radius, the size the suspension was tuned for.
        chassis:SetScale(152, 152, 152)

        // The size in the model's own units, before scaling. It is set by
        // hand because a loaded model can measure itself too small, and the
        // layer culls by it. It is a little taller than the body, so the
        // tires are inside it.
        chassis:SetDimensions(0.019, 0.0135, 0.0385)

        // Physics uses a box around the body, in world units. It is set after
        // SetScale, which would otherwise scale it too.
        //
        // The box is smaller than the body, so it doesn't catch on hills. The
        // tires touch the ground about 0.99 below the chassis center, and the
        // box is centered on it. A box 1.55 tall and 5.84 long cleared the
        // ground by only 0.2, and reached 0.86 past the front wheels, so its
        // front corner hit any slope steeper than about 14 degrees before the
        // wheels did. At 1.2 tall and 5.2 long it clears the ground by about
        // 0.39, and reaches 0.54 past the front wheels and 1.02 past the
        // back ones, so the vehicle can drive onto slopes of about 36 degrees
        // and off them at about 21. The drawn body may dip into the ground a
        // little on the steepest changes of slope.
        Box shape
        shape:Set(2.82, 1.2, 5.2)
        chassis:SetShape(shape)

        chassis:EnablePhysics(true)
        chassis:SetResponsive()
        chassis:SetMass(800)
        chassis:SetFriction(0.6)
        chassis:SetRestitution(0)
        chassis:SetLinearDamping(0.05)
        chassis:SetAngularDamping(0.8)
        chassis:SetName("Vehicle Chassis")
        AddToBoth(chassis, false, false)
    end

    /*
    This action makes the car's two headlights: warm white spotlights
    pointing ahead and a little down. PlaceHeadlights puts them at the front
    of the car every frame.
    */
    action BuildHeadlights
        SetUpHeadlight(leftHeadlight)
        SetUpHeadlight(rightHeadlight)
        PlaceHeadlights()
        headlightsOn = false
        SetHeadlights(true)
        output "Headlights: H switches them, N switches night."
    end

    /*
    This action sets one headlight's color, cone, brightness and reach.

    Attribute: Parameter light The headlight.
    */
    private action SetUpHeadlight(SpotLight light)
        Color colors
        light:SetColor(colors:CustomColor(1, 0.95, 0.8, 1))
        light:SetConeAngles(16, 28)
        light:SetIntensity(60)
        light:SetRange(45)
    end

    /*
    This action switches the headlights on or off.

    Attribute: Parameter switchOn True to switch them on.
    */
    action SetHeadlights(boolean switchOn)
        if switchOn = headlightsOn
            return now
        end
        headlightsOn = switchOn
        if switchOn
            Add(leftHeadlight)
            Add(rightHeadlight)
        else
            Remove(leftHeadlight)
            Remove(rightHeadlight)
        end
        output "Headlights: " + switchOn
    end

    /*
    This action puts the headlights at the front corners of the car, from
    its physics position, pointing the way it faces and a little down.
    */
    action PlaceHeadlights
        // Where the body is drawn, so the lights move with it on screen.
        PhysicsPosition3D place = chassis:GetDrawnTransform()
        Matrix3 basis = place:GetBasis()
        Vector3 origin = place:GetOrigin()
        Vector3 right = basis:GetColumn(0)
        Vector3 up = basis:GetColumn(1)
        Vector3 forward = basis:GetColumn(2)

        // 0.85 to each side, 0.15 up and 2.7 ahead of the body's centre.
        number aheadX = origin:GetX() + forward:GetX() * 2.7 + up:GetX() * 0.15
        number aheadY = origin:GetY() + forward:GetY() * 2.7 + up:GetY() * 0.15
        number aheadZ = origin:GetZ() + forward:GetZ() * 2.7 + up:GetZ() * 0.15
        leftHeadlight:SetPosition(aheadX - right:GetX() * 0.85, aheadY - right:GetY() * 0.85, aheadZ - right:GetZ() * 0.85)
        rightHeadlight:SetPosition(aheadX + right:GetX() * 0.85, aheadY + right:GetY() * 0.85, aheadZ + right:GetZ() * 0.85)

        number directionX = forward:GetX() - up:GetX() * 0.12
        number directionY = forward:GetY() - up:GetY() * 0.12
        number directionZ = forward:GetZ() - up:GetZ() * 0.12
        leftHeadlight:SetDirection(directionX, directionY, directionZ)
        rightHeadlight:SetDirection(directionX, directionY, directionZ)
    end

    action BuildVehicle
        vehicle:SetChassis(chassis)
        // The wheels are placed where the ToyCar's wheels are, measured from
        // the centre of its body: 1.12 to each side, 2.06 ahead and 1.58
        // behind, with their centres 0.59 below. The springs sag about
        // 9.8 / (4 * 20) = 0.12 under the car, so with a rest length of 0.4
        // the hard points sit 0.59 - (0.4 - 0.12) = 0.31 below the centre,
        // which puts the tires on the ground at rest. Tune this by eye. The
        // wheels are about as far out as the body's centre is above the
        // ground, so the car only tips on slopes steeper than about 45
        // degrees.
        vehicle:Add(AddWheel(MakeVector(-1.12, -0.31, 2.06), true))
        vehicle:Add(AddWheel(MakeVector(1.12, -0.31, 2.06), true))
        vehicle:Add(AddWheel(MakeVector(-1.12, -0.31, -1.58), false))
        vehicle:Add(AddWheel(MakeVector(1.12, -0.31, -1.58), false))
        GetCurrentLayer3D():Add(vehicle)

        // The movement behavior drives the vehicle from the arrow keys, with the
        // space bar as the brake. No drive wheels are chosen, so all four
        // wheels drive, which helps on hills.
        movement:SetVehicle(vehicle)
        // The engine must beat gravity pulling the 800 kg vehicle back down
        // the slope, which is 800 * 9.8 * sin(slope): about 3900 at 30
        // degrees, which the taller hills reach in places. 3000 couldn't
        // climb them.
        movement:SetEngineForce(5000)
        movement:SetReverseForce(3000)
        movement:SetMaximumSteering(0.45)
        chassis:AddBehavior(movement)
    end

    action AddWheel(Vector3 connection, boolean frontWheel) returns Suspension
        // The wheel has no visual item. The car's drawn wheels are part of
        // its body.
        Suspension wheel
        wheel:SetConnectionPoint(connection)
        wheel:SetDirection(MakeVector(0, -1, 0))
        wheel:SetAxle(MakeVector(1, 0, 0))
        wheel:SetRestLength(0.4)
        wheel:SetRadius(0.4)
        wheel:SetSteeringEnabled(frontWheel)
        // Softer than the flat-ground demo, so the wheels soak up bumps instead
        // of bouncing the chassis over them. The grip is close to Bullet's
        // default, so the tires slide before the vehicle tips over.
        wheel:SetSuspensionStiffness(20)
        wheel:SetDampingCompression(2.5)
        wheel:SetDampingRelaxation(2.0)
        wheel:SetFrictionSlip(10)
        // Apply the tires' sideways push almost level with the chassis center
        // instead of at the ground, so turning and side slopes barely roll the
        // vehicle. 1 would push at the ground; 0 removes the rolling entirely.
        wheel:SetRollInfluence(0.02)
        return wheel
    end

    /*
    This action puts the vehicle upright in the middle of the map, a little
    above the ground there, and stops it moving.
    */
    action ResetVehicle
        Vector3 stop
        chassis:SetYawPitchRoll(0, 0, 0)
        chassis:SetPosition(0, GetGroundHeightAt(0, 0) + dropHeight, 0)
        chassis:SetLinearVelocity(stop)
        chassis:SetAngularVelocity(stop)
        chassis:Simulate(true)
        // Place the camera behind the vehicle at once, rather than easing
        // there, if smoothing is ever turned on.
        GetCamera3D():JumpToFollowPosition()
    end

    /*
    This action places the lights that follow the vehicle: the headlights and
    the lamp. The game calls it once a frame, after the physics has run, when
    the vehicle is where it will be drawn. Placed in Update, which runs before
    the physics, they would lag behind the vehicle. The camera follows the
    vehicle on its own (Camera:Follow).
    */
    action UpdateAfterPhysics(number seconds)
        PlaceHeadlights()
        if lamp not= undefined
            lamp:SetPosition(chassis:GetX(), chassis:GetY() + 3, chassis:GetZ())
        end
    end

    action MakeVector(number x, number y, number z) returns Vector3
        Vector3 result
        result:Set(x, y, z)
        return result
    end
end
