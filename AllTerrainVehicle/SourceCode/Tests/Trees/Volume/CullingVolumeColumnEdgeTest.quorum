package Frustrum.Tests

use Libraries.Game.Graphics.Trees.CullingVolume3D
use Libraries.Compute.Vector3

/*
Tests CullingVolume3D:SetShadowColumn in two unusual cases.

A direction with no length cannot make a column. The action returns false
and leaves the volume with no planes. A box is only outside when a plane
rules it out, so Test then says every box is inside. Callers must not
search with the volume when SetShadowColumn returns false, and the trees do
not; this test records the rule.

A light shining straight down cannot use y as "up" to find the directions
across it, so the action uses z instead. The column must still have five
planes and work.

Attribute: Example
use Frustrum.Tests.CullingVolumeColumnEdgeTest
use Libraries.Testing.Tester

Tester tester
CullingVolumeColumnEdgeTest test
tester:Run(test)
*/
class CullingVolumeColumnEdgeTest is RenderTreeTest
    on create
        SetTestName("culling volume, shadow column edge cases")
    end

    /*
    This action runs the test.
    */
    action Run
        CullingVolume3D volume
        Vector3 none = MakeVector(0, 0, 0)
        CheckThat("a direction of no length returns false", not volume:SetShadowColumn(none, 0, 0, 0, 10))
        CheckWhole("a direction of no length leaves no planes", volume:GetPlaneCount(), 0)
        // With no planes, nothing rules a box out, so Test says inside.
        CheckTestResult("after a direction of no length, a box", volume:Test(MakeCube(0, 0, 0, 1)), volume:INSIDE)

        Vector3 down = MakeVector(0, -1, 0)
        CheckThat("straight down returns true", volume:SetShadowColumn(down, 0, 0, 0, 10))
        CheckWhole("straight down gives five planes", volume:GetPlaneCount(), 5)
        CheckTestResult("straight down, a box at the center", volume:Test(MakeCube(0, 0, 0, 1)), volume:INSIDE)
        CheckTestResult("straight down, a box past the distance to the side", volume:Test(MakeCube(30, 0, 0, 1)),
            volume:OUTSIDE)
        CheckTestResult("straight down, a box far above", volume:Test(MakeCube(0, 500, 0, 1)), volume:INSIDE)
        CheckTestResult("straight down, a box far below", volume:Test(MakeCube(0, -30, 0, 1)), volume:OUTSIDE)
    end
end
