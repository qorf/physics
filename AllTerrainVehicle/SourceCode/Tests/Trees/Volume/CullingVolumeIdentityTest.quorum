package Frustum.Tests

use Libraries.Game.Graphics.Trees.CullingVolume3D
use Libraries.Compute.Matrix4

/*
Tests CullingVolume3D with the identity matrix, which leaves every point
where it is. Its volume is x and y from -1 to 1, and z up to 1, with no
lower limit on z, since the volume has no near plane.

Attribute: Example
use Frustum.Tests.CullingVolumeIdentityTest
use Libraries.Testing.Tester

Tester tester
CullingVolumeIdentityTest test
tester:Run(test)
*/
class CullingVolumeIdentityTest is RenderTreeTest
    on create
        SetTestName("culling volume, identity matrix")
    end

    /*
    This action runs the test.
    */
    action Run
        Matrix4 matrix
        CullingVolume3D volume
        volume:Set(matrix)

        CheckWhole("five planes", volume:GetPlaneCount(), 5)
        CheckTestResult("a box inside", volume:Test(MakeBox(-0.5, -0.5, 0, 0.5, 0.5, 0.5)), volume:INSIDE)
        CheckTestResult("a box far away", volume:Test(MakeBox(5, 5, 5, 6, 6, 6)), volume:OUTSIDE)
        CheckTestResult("a box across the x = 1 edge", volume:Test(MakeBox(0.5, -0.5, 0, 1.5, 0.5, 0.5)),
            volume:INTERSECTING)
        CheckTestResult("a box past z = 1", volume:Test(MakeBox(-0.5, -0.5, 2, 0.5, 0.5, 3)), volume:OUTSIDE)
        CheckTestResult("a box far toward negative z, with no near plane", volume:Test(MakeBox(-0.5, -0.5, -10, 0.5, 0.5, -9)),
            volume:INSIDE)
    end
end
