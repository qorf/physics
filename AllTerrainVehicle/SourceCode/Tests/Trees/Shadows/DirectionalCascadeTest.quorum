package Frustrum.Tests

use Libraries.Game.Graphics.Trees.RenderTree3D
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Containers.Array
use Libraries.Interface.Item3D

/*
Tests CollectDirectionalShadowCasters for one cascade, with a light that has
no shadow data, as in OpenGL or before Vulkan has drawn. It must add
nothing, whatever is in the tree.

Attribute: Example
use Frustrum.Tests.DirectionalCascadeTest
use Libraries.Testing.Tester

Tester tester
DirectionalCascadeTest test
test:SetKind(test:QUAD_TREE)
tester:Run(test)
*/
class DirectionalCascadeTest is RenderTreeTest
    on create
        SetTestName("directional light cascade without shadow data")
    end

    /*
    This action runs the test.
    */
    action Run
        RenderTree3D tree = MakeTree()
        tree:Add(MakeItem(0, 0, 0, 1, 1, 1))
        tree:Add(MakeItem(5, 5, 5, 1, 1, 1), false)

        DirectionalLight light
        light:SetDirection(0, -1, 0)
        Array<Item3D> found
        tree:CollectDirectionalShadowCasters(light, 0, found)
        CheckWhole("items found for cascade 0", found:GetSize(), 0)
        tree:CollectDirectionalShadowCasters(light, 3, found)
        CheckWhole("items found for cascade 3", found:GetSize(), 0)
    end
end
