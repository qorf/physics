package Frustrum.Tests

use Libraries.Game.Graphics.Trees.RenderTree3D
use Libraries.Interface.Item3D

/*
Tests adding items to a render tree, asking whether it has them, removing
them, counting them, and emptying the tree. An item added a second time is
not added again.

Attribute: Example
use Frustrum.Tests.TreeAddRemoveTest
use Libraries.Testing.Tester

Tester tester
TreeAddRemoveTest test
test:SetKind(test:OCTREE)
tester:Run(test)
*/
class TreeAddRemoveTest is RenderTreeTest
    on create
        SetTestName("add, has, remove, size and empty")
    end

    /*
    This action runs the test.
    */
    action Run
        RenderTree3D tree = MakeTree()
        Item3D still = MakeItem(0, 0, 0, 1, 1, 1)
        Item3D moving = MakeItem(5, 0, 0, 1, 1, 1)
        Item3D never = MakeItem(10, 0, 0, 1, 1, 1)

        CheckWhole("an empty tree's size", tree:GetSize(), 0)
        CheckThat("adding a static item returns true", tree:Add(still))
        CheckThat("adding a dynamic item returns true", tree:Add(moving, false))
        CheckWhole("size", tree:GetSize(), 2)
        CheckWhole("static size", tree:GetStaticSize(), 1)
        CheckWhole("dynamic size", tree:GetDynamicSize(), 1)
        CheckThat("has the static item", tree:Has(still))
        CheckThat("has the dynamic item", tree:Has(moving))
        CheckThat("does not have an item never added", not tree:Has(never))
        CheckThat("the static item is static", tree:IsStatic(still))
        CheckThat("the dynamic item is not static", not tree:IsStatic(moving))

        CheckThat("adding an item a second time returns false", not tree:Add(still))
        CheckWhole("size after adding an item twice", tree:GetSize(), 2)

        CheckThat("removing an item returns true", tree:Remove(still))
        CheckThat("removing it again returns false", not tree:Remove(still))
        CheckThat("removing an item never added returns false", not tree:Remove(never))
        CheckThat("does not have the removed item", not tree:Has(still))
        CheckWhole("size after removing", tree:GetSize(), 1)
        CheckWhole("static size after removing", tree:GetStaticSize(), 0)

        tree:Add(still)
        tree:Empty()
        CheckWhole("size after emptying", tree:GetSize(), 0)
        CheckWhole("static size after emptying", tree:GetStaticSize(), 0)
        CheckWhole("dynamic size after emptying", tree:GetDynamicSize(), 0)
        CheckThat("does not have an item after emptying", not tree:Has(moving))
        CheckThat("an item can be added again after emptying", tree:Add(moving))
    end
end
