package Physics.Tests

use Libraries.Game.Collision.LocalCollisionPoints3D

/*
A small gap inside the contact threshold is kept, and a larger one is not.
The threshold is 0.02.

Unless a test says otherwise, the triangle is the standard one with no
margin, and the triangle is item A, the way terrain calls it. A stored
contact's normal then points from the sphere toward the triangle, and
its point on B is on the sphere's surface.
*/
class SphereTriangleThresholdTest is PhysicsTest
    on create
        SetName("Sphere and triangle: contact threshold")
    end

    action Run
        LocalCollisionPoints3D points = RunSphere(0.25, 0.51, -0.25, 0.5, 0, false)
        CheckContact("sphere gap inside threshold", points, 0, -1, 0, 0.25, 0.01, -0.25, 0.01)

        points = RunSphere(0.25, 0.53, -0.25, 0.5, 0, false)
        CheckWhole("sphere gap past threshold", points:GetPointCount(), 0)
    end
end
