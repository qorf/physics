package Physics.Tests

use Libraries.Compute.Math
use Libraries.Game.Collision.LocalCollisionPoints3D

/*
The same box turned 45 degrees about the up axis. Its corners now point
along x and z.

Unless a test says otherwise, the triangle is a large one lying flat
at height 0, from MakeLargeTriangle, with the usual margin of 0.04, so
its thickened surface is at 0.04. The box is 0.5 on each side for
collisions (see RunBox), with no rotation, and the triangle is item A.
A box whose center is at 0.28 has its bottom at 0.03, so it sinks 0.01
into the surface.
*/
class BoxTriangleTurnedTest is PhysicsTest
    on create
        SetName("Box and triangle: turned 45 degrees")
    end

    action Run
        Math math
        LocalCollisionPoints3D points = RunBox(MakeLargeTriangle(0.04), MakeTransform(0, 0.28, 0, 0, 1, 0, 45), false)
        CheckWhole("box turned: four contacts", points:GetPointCount(), 4)
        CheckAllContacts("box turned", points, 0, -1, 0, -0.01)
        number reach = 0.25 * math:SquareRoot(2)
        CheckWhole("box turned: corner along +x", CountContactsNear(points, reach, 0.03, 0), 1)
        CheckWhole("box turned: corner along -x", CountContactsNear(points, -reach, 0.03, 0), 1)
        CheckWhole("box turned: corner along +z", CountContactsNear(points, 0, 0.03, reach), 1)
        CheckWhole("box turned: corner along -z", CountContactsNear(points, 0, 0.03, -reach), 1)
    end
end
