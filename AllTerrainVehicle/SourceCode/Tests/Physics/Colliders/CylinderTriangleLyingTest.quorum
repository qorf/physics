package Physics.Tests

use Libraries.Game.Collision.LocalCollisionPoints3D

/*
A cylinder turned 90 degrees about z lies on its side along x. The two
ends of its lowest line are the contacts.

Unless a test says otherwise, the triangle is the large flat one with
a margin of 0.04, and the cylinder has radius 0.3 and height 1, made
by Cylinder:Set(0.6, 1, 0.6), standing along y. Standing with its
center at 0.53, its bottom is at 0.03, 0.01 into the surface.
*/
class CylinderTriangleLyingTest is PhysicsTest
    on create
        SetName("Cylinder and triangle: lying")
    end

    action Run
        LocalCollisionPoints3D points = RunCylinder(MakeLargeTriangle(0.04), MakeCylinder(), MakeTransform(0, 0.33, 0, 0, 0, 1, 90), false)
        CheckWhole("cylinder lying: two contacts", points:GetPointCount(), 2)
        CheckAllContacts("cylinder lying", points, 0, -1, 0, -0.01)
        CheckWhole("cylinder lying: one end", CountContactsNear(points, 0.5, 0.03, 0), 1)
        CheckWhole("cylinder lying: other end", CountContactsNear(points, -0.5, 0.03, 0), 1)
        CheckThat("cylinder lying: did not use the general test", not CylinderUsedGeneralTest())
    end
end
