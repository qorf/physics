package Physics.Tests

use Libraries.Game.Collision.LocalCollisionPoints3D

/*
With a margin of 0.04, the triangle's surface is 0.04 above its plane, so
a sphere whose bottom is at 0.02 sinks 0.02 into it.

Unless a test says otherwise, the triangle is the standard one with no
margin, and the triangle is item A, the way terrain calls it. A stored
contact's normal then points from the sphere toward the triangle, and
its point on B is on the sphere's surface.
*/
class SphereTriangleMarginTest is PhysicsTest
    on create
        SetName("Sphere and triangle: triangle margin")
    end

    action Run
        LocalCollisionPoints3D points = RunSphere(0.25, 0.52, -0.25, 0.5, 0.04, false)
        CheckContact("sphere margin", points, 0, -1, 0, 0.25, 0.02, -0.25, -0.02)
        if points:GetPointCount() = 1
            CheckVector("sphere margin: point on A is on the thickened surface",
                points:GetCollisionPoint(0):GetWorldPositionOnA(), 0.25, 0.04, -0.25)
        end
    end
end
