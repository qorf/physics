package Physics.Tests

use Libraries.Game.Collision.LocalCollisionPoints3D

/*
A sphere whose center is exactly on the triangle has no direction to the
closest point, so the face normal is used.

Unless a test says otherwise, the triangle is the standard one with no
margin, and the triangle is item A, the way terrain calls it. A stored
contact's normal then points from the sphere toward the triangle, and
its point on B is on the sphere's surface.
*/
class SphereTriangleCenterOnTriangleTest is PhysicsTest
    on create
        SetName("Sphere and triangle: center on the triangle")
    end

    action Run
        LocalCollisionPoints3D points = RunSphere(0.25, 0, -0.25, 0.5, 0, false)
        CheckContact("sphere centered on the face", points, 0, -1, 0, 0.25, -0.5, -0.25, -0.5)
    end
end
