package Physics.Tests

use Libraries.Interface.Item3D
use Libraries.Game.Collision.PhysicsPosition3D
use Libraries.Game.Collision.LocalCollisionPoints3D
use Libraries.Game.Collision.CollisionPointsResult3D
use Libraries.Game.Collision.Shapes.Sphere
use Libraries.Game.Collision.Shapes.Box
use Libraries.Game.Collision.Shapes.Cylinder
use Libraries.Game.Collision.Shapes.Triangle
use Libraries.Game.Collision.Narrowphase.SharedNarrowSolver

/*
Tests SharedNarrowSolver's actions for a sphere, box or cylinder item
colliding with a single triangle item, in both orders. The normal from B
toward A points up when the shape is item A, and down when the triangle is,
and the contacts are refreshed, so they stay stored.
*/
class RoutingItemTriangleTest is PhysicsTest
    on create
        SetName("Routing: shapes against a single triangle item")
    end

    action Run
        SharedNarrowSolver solver
        PhysicsPosition3D identity
        Item3D triangleItem = MakeItemAt(identity)

        // Sphere, 0.1 into the standard triangle.
        Triangle triangle = MakeStandardTriangle(0)
        Sphere sphere
        sphere:SetRadius(0.5)
        PhysicsPosition3D sphereAt = MakeTransform(0.25, 0.4, -0.25, 0, 1, 0, 0)
        Item3D sphereItem = MakeItemAt(sphereAt)

        LocalCollisionPoints3D points
        CollisionPointsResult3D result
        points:Set(sphereItem, triangleItem)
        result:Initialize(sphereItem, triangleItem)
        solver:CollideSphereTriangle(points, sphere, sphereAt, triangle, identity, result)
        CheckContact("sphere as item A", points, 0, 1, 0, 0.25, 0, -0.25, -0.1)

        LocalCollisionPoints3D reversed
        CollisionPointsResult3D reversedResult
        reversed:Set(triangleItem, sphereItem)
        reversedResult:Initialize(triangleItem, sphereItem)
        solver:CollideTriangleSphere(reversed, triangle, identity, sphere, sphereAt, reversedResult)
        CheckContact("triangle as item A, with a sphere", reversed, 0, -1, 0, 0.25, -0.1, -0.25, -0.1)

        // Box, flat on the large triangle.
        Triangle large = MakeLargeTriangle(0.04)
        Box box = MakeBox(0.5, 0.5, 0.5)
        PhysicsPosition3D boxAt = MakeTransform(0, 0.28, 0, 0, 1, 0, 0)
        Item3D boxItem = MakeItemAt(boxAt)

        LocalCollisionPoints3D boxPoints
        CollisionPointsResult3D boxResult
        boxPoints:Set(boxItem, triangleItem)
        boxResult:Initialize(boxItem, triangleItem)
        solver:CollideBoxTriangle(boxPoints, box, boxAt, large, identity, boxResult)
        CheckWhole("box as item A: four contacts", boxPoints:GetPointCount(), 4)
        CheckAllContacts("box as item A", boxPoints, 0, 1, 0, -0.01)

        LocalCollisionPoints3D boxReversed
        CollisionPointsResult3D boxReversedResult
        boxReversed:Set(triangleItem, boxItem)
        boxReversedResult:Initialize(triangleItem, boxItem)
        solver:CollideTriangleBox(boxReversed, large, identity, box, boxAt, boxReversedResult)
        CheckWhole("triangle as item A, with a box: four contacts", boxReversed:GetPointCount(), 4)
        CheckAllContacts("triangle as item A, with a box", boxReversed, 0, -1, 0, -0.01)

        // Cylinder, standing on the large triangle.
        Cylinder cylinder = MakeCylinder()
        PhysicsPosition3D cylinderAt = MakeTransform(0, 0.53, 0, 0, 1, 0, 0)
        Item3D cylinderItem = MakeItemAt(cylinderAt)

        LocalCollisionPoints3D cylinderPoints
        CollisionPointsResult3D cylinderResult
        cylinderPoints:Set(cylinderItem, triangleItem)
        cylinderResult:Initialize(cylinderItem, triangleItem)
        solver:CollideCylinderTriangle(cylinderPoints, cylinder, cylinderAt, large, identity, cylinderResult)
        CheckWhole("cylinder as item A: four contacts", cylinderPoints:GetPointCount(), 4)
        CheckAllContacts("cylinder as item A", cylinderPoints, 0, 1, 0, -0.01)

        LocalCollisionPoints3D cylinderReversed
        CollisionPointsResult3D cylinderReversedResult
        cylinderReversed:Set(triangleItem, cylinderItem)
        cylinderReversedResult:Initialize(triangleItem, cylinderItem)
        solver:CollideTriangleCylinder(cylinderReversed, large, identity, cylinder, cylinderAt, cylinderReversedResult)
        CheckWhole("triangle as item A, with a cylinder: four contacts", cylinderReversed:GetPointCount(), 4)
        CheckAllContacts("triangle as item A, with a cylinder", cylinderReversed, 0, -1, 0, -0.01)
    end
end
