package Rendering

use Libraries.Containers.List
use Libraries.Containers.HashTable
use Libraries.Containers.Iterator
use Libraries.Interface.Item3D
use Libraries.Game.BoundingBox
use Libraries.Game.Graphics.Model
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.Color
use Libraries.Game.Graphics.PointLight
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Game.Graphics.CascadeShadowData
use Libraries.Game.Graphics.Models.ModelBlueprint
use Libraries.Compute.Matrix4
use Libraries.Compute.Vector3
use Libraries.Compute.Math

/*
RenderTree3D keeps track of where every drawable item in a 3D scene is, so
that drawing and shadows only handle the items that matter. It answers these
questions:

- Which items can the camera see? (CollectVisible)
- Which items could cast a shadow into one cascade of a directional light's
  shadows? (CollectDirectionalShadowCasters)
- Which items are within a point light's reach? (CollectPointShadowCasters)
- Which items overlap a box or a sphere? (CollectInBox, CollectInSphere)

Each answer is added to a List the caller passes in. The caller empties the
list when it starts a new frame or pass. The answers include hidden items;
the caller can leave them out with IsShowing or IsShowingWithParents.

The tree is in two halves, each a RenderBoundingVolumeTree3D:

- The static half holds items that do not move, such as scenery and terrain
  chunks. Its boxes fit their items exactly.
- The dynamic half holds items that move. Its boxes are a little bigger than
  their items, so small moves do not change the tree.

A static item that moves is moved to the dynamic half. A dynamic item that
has not moved for a while is moved back to the static half by EndFrame.

The tree does not watch items for changes. Whoever owns it, such as Layer3D,
calls Moved for each item whose position, rotation or scale has changed,
once per frame before drawing, and EndFrame after drawing.

Only items with bounds can be added. An item whose bounds cannot be found,
such as one that draws itself, is not added, and Add returns false. Its owner
draws it every frame, without asking the tree.
*/
class RenderTree3D
    // How much bigger than its item a dynamic leaf's box is, on every side.
    // A bigger margin means fewer changes to the tree as items move, but
    // more items drawn just outside the view.
    constant number DYNAMIC_MARGIN = 0.25

    // How many frames a dynamic item must stay still before it is moved to
    // the static half.
    constant integer FRAMES_UNTIL_STATIC = 120

    // How often, in frames, still dynamic items are checked.
    constant integer CHECK_INTERVAL = 30

    // The light level below which a point light is treated as having no
    // effect. This must match EnvironmentVulkan, which uses the same value
    // to decide how far a point light's shadows reach.
    constant number MINIMUM_ILLUMINATION_THRESHOLD = 0.0003

    RenderBoundingVolumeTree3D staticTree
    RenderBoundingVolumeTree3D dynamicTree

    // The leaf for each item in the tree.
    HashTable<Item3D, RenderTreeNode3D> leaves

    // The leaves in the dynamic half, checked by EndFrame.
    List<RenderTreeNode3D> dynamicLeaves

    // The bounds of each model blueprint, measured once. Many models share
    // a blueprint, and measuring means reading every vertex.
    HashTable<ModelBlueprint, BoundingBox> blueprintBounds

    HashTable<PointLight, ShadowCasterCache3D> pointLightCasters

    integer frame = 0
    integer staticVersion = 0

    CullingVolume3D volume
    BoundingBox worldBounds
    Vector3 minimum
    Vector3 maximum
    Math math

    on create
        staticTree:SetMargin(0)
        dynamicTree:SetMargin(DYNAMIC_MARGIN)
    end

    /*
    This action adds an item that is not expected to move. If the item does
    move later, Moved puts it in the dynamic half.

    Attribute: Parameter item The item to add.
    Attribute: Returns True if the item was added. False if it was already in
    the tree, or has no bounds the tree can find.
    */
    action Add(Item3D item) returns boolean
        return Add(item, true)
    end

    /*
    This action adds an item, using bounds the tree finds for it. For a
    model, those are its blueprint's bounds. For any other item, they are a
    box of the item's width, height and depth, centered on the item.

    Attribute: Parameter item The item to add.
    Attribute: Parameter isStatic True if the item is not expected to move.
    Attribute: Returns True if the item was added. False if it was already in
    the tree, or has no bounds the tree can find.
    */
    action Add(Item3D item, boolean isStatic) returns boolean
        if item = undefined or Has(item)
            return false
        end
        BoundingBox local = GetBounds(item)
        if local = undefined
            return false
        end
        return Add(item, local, isStatic)
    end

    /*
    This action adds an item that is not expected to move, with the given
    bounds in its own coordinates.
    */
    action Add(Item3D item, BoundingBox localBounds) returns boolean
        return Add(item, localBounds, true)
    end

    /*
    This action adds an item with the given bounds in its own coordinates.
    Use it for items whose bounds the tree cannot find, such as terrain
    chunks. A terrain chunk should give bounds that hold every level of
    detail, so changing the level does not change the tree.

    Attribute: Parameter item The item to add.
    Attribute: Parameter localBounds The item's bounds in its own coordinates.
    Attribute: Parameter isStatic True if the item is not expected to move.
    Attribute: Returns True if the item was added, false if it was already in
    the tree.
    */
    action Add(Item3D item, BoundingBox localBounds, boolean isStatic) returns boolean
        if item = undefined or Has(item)
            return false
        end

        RenderTreeNode3D leaf
        leaf:item = item
        leaf:SetLocalBounds(localBounds)
        leaf:lastMovedFrame = frame
        CalculateWorldBounds(leaf, worldBounds)

        if isStatic
            leaf:isStatic = true
            staticTree:Insert(leaf, worldBounds)
            staticVersion = staticVersion + 1
        else
            dynamicTree:Insert(leaf, worldBounds)
            dynamicLeaves:Add(leaf)
        end
        leaves:Add(item, leaf)
        return true
    end

    /*
    This action removes an item. If the item is a point light, the static
    shadow casters remembered for it are also forgotten.

    Attribute: Returns True if the item was in the tree.
    */
    action Remove(Item3D item) returns boolean
        if item is PointLight
            pointLightCasters:RemoveKey(cast(PointLight, item))
        end

        RenderTreeNode3D leaf = leaves:RemoveKey(item)
        if leaf = undefined
            return false
        end

        if leaf:isStatic
            staticTree:Remove(leaf)
            staticVersion = staticVersion + 1
        else
            dynamicTree:Remove(leaf)
            dynamicLeaves:Remove(leaf)
        end
        leaf:Reset()
        return true
    end

    /*
    This action returns true if the item is in the tree.
    */
    action Has(Item3D item) returns boolean
        return leaves:HasKey(item)
    end

    /*
    This action tells the tree an item's position, rotation or scale has
    changed. A static item that has really moved goes to the dynamic half.
    */
    action Moved(Item3D item)
        RenderTreeNode3D leaf = leaves:GetValue(item)
        if leaf = undefined
            return now
        end

        CalculateWorldBounds(leaf, worldBounds)
        if leaf:isStatic
            // A static leaf's box fits its item exactly, so if the bounds
            // are unchanged the item has not really moved.
            if HasSameBounds(leaf:bounds, worldBounds)
                return now
            end
            staticTree:Remove(leaf)
            staticVersion = staticVersion + 1
            leaf:isStatic = false
            dynamicTree:Insert(leaf, worldBounds)
            dynamicLeaves:Add(leaf)
        else
            dynamicTree:Move(leaf, worldBounds)
        end
        leaf:lastMovedFrame = frame
    end

    /*
    This action changes an item's bounds in its own coordinates, for example
    when its mesh or its level of detail changes.
    */
    action SetLocalBounds(Item3D item, BoundingBox localBounds)
        RenderTreeNode3D leaf = leaves:GetValue(item)
        if leaf = undefined
            return now
        end
        leaf:SetLocalBounds(localBounds)
        Moved(item)
    end

    /*
    This action ends a frame. Every CHECK_INTERVAL frames, dynamic items
    that have not moved for FRAMES_UNTIL_STATIC frames are moved to the
    static half.
    */
    action EndFrame
        frame = frame + 1
        if frame mod CHECK_INTERVAL not= 0
            return now
        end

        List<RenderTreeNode3D> stillMoving
        Iterator<RenderTreeNode3D> iterator = dynamicLeaves:GetIterator()
        repeat while iterator:HasNext()
            RenderTreeNode3D leaf = iterator:Next()
            if frame - leaf:lastMovedFrame >= FRAMES_UNTIL_STATIC
                dynamicTree:Remove(leaf)
                CalculateWorldBounds(leaf, worldBounds)
                leaf:isStatic = true
                staticTree:Insert(leaf, worldBounds)
                staticVersion = staticVersion + 1
            else
                stillMoving:Add(leaf)
            end
        end
        dynamicLeaves = stillMoving
    end

    /*
    This action adds the items the camera can see to the results.
    */
    action CollectVisible(Camera camera, List<Item3D> results)
        CollectVisible(camera:GetCombinedMatrix(), results)
    end

    /*
    This action adds the items inside the view of the given view-projection
    matrix to the results.
    */
    action CollectVisible(Matrix4 viewProjection, List<Item3D> results)
        volume:Set(viewProjection)
        staticTree:Collect(volume, results)
        dynamicTree:Collect(volume, results)
    end

    /*
    This action adds the items that could cast a shadow into one cascade of
    a directional light's shadows to the results. Each cascade covers part
    of the camera's view and is drawn in its own pass, so this is asked once
    per cascade.

    The cascade's view-projection matrix comes from the light's shadow data,
    which EnvironmentVulkan updates each frame, so ask after it has. A light
    without shadow data for the cascade, such as in OpenGL, adds nothing.

    Attribute: Parameter light The directional light.
    Attribute: Parameter cascade Which cascade, counting from 0.
    Attribute: Parameter results The list to add the items to.
    */
    action CollectDirectionalShadowCasters(DirectionalLight light, integer cascade, List<Item3D> results)
        CascadeShadowData data = light:GetShadowData(cascade)
        if data = undefined
            return now
        end
        // A directional light's cascade uses only the first of its matrices.
        volume:Set(data:GetProjectionMatrix(0))
        staticTree:Collect(volume, results)
        dynamicTree:Collect(volume, results)
    end

    /*
    This action adds the items within a point light's reach to the results.
    Static items are found once and remembered, until the light moves, its
    reach changes, or the static items change.
    */
    action CollectPointShadowCasters(PointLight light, List<Item3D> results)
        number x = light:GetGlobalX()
        number y = light:GetGlobalY()
        number z = light:GetGlobalZ()
        number range = GetPointLightRange(light)

        ShadowCasterCache3D cache = pointLightCasters:GetValue(light)
        if cache = undefined
            ShadowCasterCache3D newCache
            cache = newCache
            pointLightCasters:Add(light, cache)
        end

        if not cache:Matches(x, y, z, range, staticVersion)
            cache:statics:Empty()
            staticTree:Collect(x, y, z, range, cache:statics)
            cache:Set(x, y, z, range, staticVersion)
        end

        Iterator<Item3D> iterator = cache:statics:GetIterator()
        repeat while iterator:HasNext()
            results:Add(iterator:Next())
        end
        dynamicTree:Collect(x, y, z, range, results)
    end

    /*
    This action adds the items overlapping a box to the results.
    */
    action CollectInBox(BoundingBox box, List<Item3D> results)
        staticTree:Collect(box, results)
        dynamicTree:Collect(box, results)
    end

    /*
    This action adds the items overlapping a sphere to the results.
    */
    action CollectInSphere(number x, number y, number z, number radius, List<Item3D> results)
        staticTree:Collect(x, y, z, radius, results)
        dynamicTree:Collect(x, y, z, radius, results)
    end

    /*
    This action returns how far a point light reaches, with the same formula
    EnvironmentVulkan uses for point light shadows: the distance at which
    the light's brightest color, at its intensity, falls below
    MINIMUM_ILLUMINATION_THRESHOLD.
    */
    action GetPointLightRange(PointLight light) returns number
        Color color = light:GetColor()
        number brightest = color:GetRed()
        if color:GetGreen() > brightest
            brightest = color:GetGreen()
        end
        if color:GetBlue() > brightest
            brightest = color:GetBlue()
        end
        return math:SquareRoot(brightest * light:GetIntensity() / MINIMUM_ILLUMINATION_THRESHOLD)
    end

    /*
    This action returns true if the item is showing. It does not look at
    the item's parents, so an item whose parent is hidden still counts as
    showing.
    */
    action IsShowing(Item3D item) returns boolean
        return item:IsShowing()
    end

    /*
    This action returns true if the item and all of its parents are showing.
    Layer3D draws by walking down from each item, so a hidden parent hides
    its children. The tree holds items on their own, so this checks upward
    instead.
    */
    action IsShowingWithParents(Item3D item) returns boolean
        Item3D current = item
        repeat while current not= undefined
            if not current:IsShowing()
                return false
            end
            current = current:GetParent()
        end
        return true
    end

    /*
    This action returns how many items are in the tree.
    */
    action GetSize returns integer
        return staticTree:GetSize() + dynamicTree:GetSize()
    end

    /*
    This action returns how many items are in the static half.
    */
    action GetStaticSize returns integer
        return staticTree:GetSize()
    end

    /*
    This action returns how many items are in the dynamic half.
    */
    action GetDynamicSize returns integer
        return dynamicTree:GetSize()
    end

    /*
    This action returns a number that goes up by one every time the static
    half changes: when an item is added to it or removed from it, when a
    static item moves and goes to the dynamic half, or when a still item
    comes back from the dynamic half. Items in the static half never move,
    so anything worked out from them stays correct until this number
    changes.

    Use it to keep work that depends only on static items, such as a list of
    the static items within a light's reach, or data prepared for drawing
    static items. Save the number when doing the work, and redo the work
    only when GetStaticVersion returns a different number. The tree does
    this itself for point light shadow casters.
    */
    action GetStaticVersion returns integer
        return staticVersion
    end

    /*
    This action returns an item's bounds in its own coordinates, or undefined
    if it has none the tree can find.

    For a model, they are its blueprint's bounds, measured once per
    blueprint. The library's blueprints have bugs here: the OpenGL blueprint
    measures only its first node, and the Vulkan blueprint can miss the
    largest value on an axis. So bounds whose minimum is above their maximum
    on any axis are treated as missing. Flat bounds, such as a plane's, are
    allowed, though BoundingBox:IsValid would reject them.

    For any other item, they are a box of its width, height and depth,
    centered on the item. An item with no size has no bounds.
    */
    private action GetBounds(Item3D item) returns BoundingBox
        if item is Model
            Model model = cast(Model, item)
            ModelBlueprint schematic = model:GetModelBlueprint()
            if schematic = undefined
                return undefined
            end

            if blueprintBounds:HasKey(schematic)
                return blueprintBounds:GetValue(schematic)
            end

            BoundingBox bounds
            model:CalculateBoundingBox(bounds)
            if bounds:GetMinimum():GetX() > bounds:GetMaximum():GetX() or
                    bounds:GetMinimum():GetY() > bounds:GetMaximum():GetY() or
                    bounds:GetMinimum():GetZ() > bounds:GetMaximum():GetZ()
                return undefined
            end
            blueprintBounds:Add(schematic, bounds)
            return bounds
        end

        number halfWidth = item:GetWidth() / 2
        number halfHeight = item:GetHeight() / 2
        number halfDepth = item:GetDepth() / 2
        if halfWidth = 0 and halfHeight = 0 and halfDepth = 0
            return undefined
        end
        BoundingBox box
        minimum:Set(-halfWidth, -halfHeight, -halfDepth)
        maximum:Set(halfWidth, halfHeight, halfDepth)
        box:Set(minimum, maximum)
        return box
    end

    /*
    This action puts a leaf's item's bounds in world coordinates into the
    given box.

    The item's bounds in its own coordinates are a center and half sizes.
    The world center is the item's transform applied to the center. The
    world half size on each axis is the sum of the absolute values of the
    transform's entries in that row, each times the matching half size. This
    is the smallest axis-aligned box around the turned box, and needs no
    corners. The transform includes the item's scale and its parent's offset.
    */
    private action CalculateWorldBounds(RenderTreeNode3D leaf, BoundingBox out)
        Matrix4 transform = leaf:item:GetTransform()
        number cx = leaf:localCenterX
        number cy = leaf:localCenterY
        number cz = leaf:localCenterZ
        number hx = leaf:localHalfX
        number hy = leaf:localHalfY
        number hz = leaf:localHalfZ

        number worldX = transform:row0column0 * cx + transform:row0column1 * cy + transform:row0column2 * cz + transform:row0column3
        number worldY = transform:row1column0 * cx + transform:row1column1 * cy + transform:row1column2 * cz + transform:row1column3
        number worldZ = transform:row2column0 * cx + transform:row2column1 * cy + transform:row2column2 * cz + transform:row2column3

        number halfX = math:AbsoluteValue(transform:row0column0) * hx + math:AbsoluteValue(transform:row0column1) * hy +
            math:AbsoluteValue(transform:row0column2) * hz
        number halfY = math:AbsoluteValue(transform:row1column0) * hx + math:AbsoluteValue(transform:row1column1) * hy +
            math:AbsoluteValue(transform:row1column2) * hz
        number halfZ = math:AbsoluteValue(transform:row2column0) * hx + math:AbsoluteValue(transform:row2column1) * hy +
            math:AbsoluteValue(transform:row2column2) * hz

        minimum:Set(worldX - halfX, worldY - halfY, worldZ - halfZ)
        maximum:Set(worldX + halfX, worldY + halfY, worldZ + halfZ)
        out:Set(minimum, maximum)
    end

    /*
    This action returns true if two boxes have the same corners.
    */
    private action HasSameBounds(BoundingBox first, BoundingBox second) returns boolean
        return first:GetMinimum():GetX() = second:GetMinimum():GetX() and
            first:GetMinimum():GetY() = second:GetMinimum():GetY() and
            first:GetMinimum():GetZ() = second:GetMinimum():GetZ() and
            first:GetMaximum():GetX() = second:GetMaximum():GetX() and
            first:GetMaximum():GetY() = second:GetMaximum():GetY() and
            first:GetMaximum():GetZ() = second:GetMaximum():GetZ()
    end
end
