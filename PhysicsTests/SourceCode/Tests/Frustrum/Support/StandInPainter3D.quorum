package Frustrum.Tests

use Libraries.Game.Graphics.Painter3D
use Libraries.Game.Graphics.Camera
use Libraries.Game.Graphics.Skybox
use Libraries.Game.Graphics.Environment
use Libraries.Game.Graphics.Model

/*
StandInPainter3D is a painter that does nothing. The layer tests give it to
their layers with SetPainter, so Layer3D.Draw can be called from a test
without drawing a frame on the graphics card. The test items record what
the layer draws instead. This one stands in for OpenGL's painter.

Attribute: Example
use Frustrum.Tests.StandInPainter3D
use Libraries.Game.Layer3D

StandInPainter3D painter
Layer3D layer
layer:SetPainter(painter)
*/
class StandInPainter3D is Painter3D
    /*
    This action does nothing.

    Attribute: Parameter camera The camera.
    */
    action SetCamera(Camera camera)
    end

    /*
    This action does nothing.
    */
    action Begin
    end

    /*
    This action does nothing.
    */
    action End
    end

    /*
    This action does nothing.

    Attribute: Parameter skybox The skybox.
    */
    action SetSkybox(Skybox skybox)
    end

    /*
    This action does nothing.

    Attribute: Parameter environment The environment.
    */
    action SetEnvironment(Environment environment)
    end

    /*
    This action does nothing.

    Attribute: Parameter model The model.
    */
    action Render(Model model)
    end
end
