package Frustrum.Tests

use Libraries.Game.Graphics.Vulkan.VulkanPainter3D
use Libraries.Game.Graphics.Model

/*
StandInVulkanPainter3D is a Vulkan painter that draws nothing. Layer3D.Draw
only searches for shadow casters when its painter is a VulkanPainter3D, so
the layer tests use this, with SetPainter, to test that search without
drawing a frame on the graphics card. Begin, End and Render do nothing; the
test items record what the layer draws instead. It must only be made while
the game is using Vulkan.

Attribute: Example
use Frustrum.Tests.StandInVulkanPainter3D
use Libraries.Game.Layer3D

StandInVulkanPainter3D painter
Layer3D layer
layer:SetPainter(painter)
*/
class StandInVulkanPainter3D is VulkanPainter3D
    /*
    This action does nothing.
    */
    action Begin
    end

    /*
    This action does nothing.
    */
    action End
    end

    /*
    This action does nothing.

    Attribute: Parameter model The model.
    */
    action Render(Model model)
    end
end
