package Frustum.Tests

use Libraries.Game.Layer3D

/*
Tests the order a layer draws transparent models in: after every item that
is not transparent, and from farthest to nearest, so each blends over what
is behind it. Moving the camera to the other side reverses their order.

Attribute: Example
use Frustum.Tests.LayerTransparencyTest
use Libraries.Testing.Tester

// Run from a game's CreateGame, since a Layer3D needs a running game.
Tester tester
LayerTransparencyTest test
tester:Run(test)
*/
class LayerTransparencyTest is LayerCullingTest
    on create
        SetName("Layer culling: transparent models are drawn last, farthest first")
    end

    /*
    This action runs the test.
    */
    action Run
        Layer3D layer = MakeLayer()
        DrawLog log
        CountingModel near = AddCountingModel(layer, log, 0, 0, 5)
        near:EnableTransparency(true)
        CountingModel middle = AddCountingModel(layer, log, 0, 0, 10)
        middle:EnableTransparency(true)
        CountingModel far = AddCountingModel(layer, log, 0, 0, 20)
        far:EnableTransparency(true)
        CountingItem3D solid = AddCounting(layer, log, 0, 0, 15)
        CountingModel solidModel = AddCountingModel(layer, log, 2, 0, 25)

        DrawLayer(layer, log)
        CheckDrawn("the near transparent model", log, near, 1)
        CheckDrawn("the middle transparent model", log, middle, 1)
        CheckDrawn("the far transparent model", log, far, 1)
        CheckDrawn("the item that is not transparent", log, solid, 1)
        CheckDrawn("the model that is not transparent", log, solidModel, 1)
        CheckThat("the item is drawn before the transparent models", log:PlaceOf(solid) < log:PlaceOf(far))
        CheckThat("the model is drawn before the transparent models", log:PlaceOf(solidModel) < log:PlaceOf(far))
        CheckThat("the far transparent model is drawn before the middle one", log:PlaceOf(far) < log:PlaceOf(middle))
        CheckThat("the middle transparent model is drawn before the near one", log:PlaceOf(middle) < log:PlaceOf(near))

        PlaceCamera(layer, 0, 0, 40, 0, 0, 0)
        DrawLayer(layer, log)
        CheckThat("from the other side, the model at z 5 is drawn before the one at z 10",
            log:PlaceOf(near) < log:PlaceOf(middle))
        CheckThat("from the other side, the model at z 10 is drawn before the one at z 20",
            log:PlaceOf(middle) < log:PlaceOf(far))
        CheckThat("from the other side, the item is still drawn before the transparent models",
            log:PlaceOf(solid) < log:PlaceOf(near))
    end
end
