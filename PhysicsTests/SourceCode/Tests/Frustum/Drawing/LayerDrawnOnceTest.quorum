package Frustum.Tests

use Libraries.Game.Layer3D
use Libraries.Game.Graphics.DirectionalLight
use Libraries.Game.Graphics.PointLight

/*
Tests that an item found by more than one search in a frame is drawn once.
With Vulkan, a layer searches for the items the camera sees, then for the
items that could cast a shadow into view, and an item in front of the
camera, near it, is found by both. With OpenGL there is no shadow search,
and the item is still drawn once.

Attribute: Example
use Frustum.Tests.LayerDrawnOnceTest
use Libraries.Testing.Tester

// Run from a game's CreateGame, since a Layer3D needs a running game.
Tester tester
LayerDrawnOnceTest test
tester:Run(test)
*/
class LayerDrawnOnceTest is LayerCullingTest
    on create
        SetName("Layer culling: an item found twice is drawn once")
    end

    /*
    This action runs the test.
    */
    action Run
        Layer3D layer = MakeLayer()
        DrawLog log
        DirectionalLight sun
        sun:SetDirection(0, -1, 0)
        layer:Add(sun)
        PointLight lamp
        lamp:SetColor(1, 1, 1, 1)
        lamp:SetIntensity(0.03)
        lamp:SetPosition(0, 0, 10)
        layer:Add(lamp)

        CountingItem3D item = AddCounting(layer, log, 0, 0, 10)
        CountingModel model = AddCountingModel(layer, log, 1, 0, 10)
        DrawLayer(layer, log)
        CheckDrawn("an item in view, near the camera and the lamp", log, item, 1)
        CheckDrawn("a model in view, near the camera and the lamp", log, model, 1)
        DrawLayer(layer, log)
        CheckDrawn("the item, in the next frame", log, item, 1)
    end
end
