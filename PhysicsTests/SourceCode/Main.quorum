use Libraries.Game.Game
use Libraries.Testing.Tester
use Libraries.Testing.Test
use Libraries.Containers.Iterator
use Physics.Tests.PhysicsWorldTester
use Frustum.Tests.LayerCullingTester

/*
Main runs the physics world tests and the layer culling tests. These tests
need what a Layer3D needs, which is a running game. Main starts the game,
runs every test once the window exists, writes which tests failed, and
closes the game.

The physics world tests build small worlds, step them, and check how the
items move. The layer culling tests check what a Layer3D holds and what its
Draw hands out, using a stand-in painter that draws nothing. Each test
builds its own Layer3D, separate from the game's, and nothing is drawn, so
the window stays blank while the tests run.

The game uses Vulkan while useVulkan is true. A Vulkan layer also draws the
items out of view that cast shadows into it, so only then do the shadow
tests check that. Set it to false to run everything with OpenGL.
*/
class Main is Game
    boolean useVulkan = true

    action Main
        UseVulkan(useVulkan)
        StartGame()
    end

    action CreateGame
        Tester worldTester
        PhysicsWorldTester world
        world:SetTester(worldTester)
        world:Test()
        Report(world:GetName(), worldTester)

        Tester cullingTester
        LayerCullingTester culling
        culling:SetTester(cullingTester)
        culling:Test()
        Report(culling:GetName(), cullingTester)

        Exit()
    end

    /*
    This action writes how many tests in a group passed, and which failed.

    Attribute: Parameter name The group's name.
    Attribute: Parameter tester The Tester that ran the group.
    */
    action Report(text name, Tester tester)
        output name + ": " + tester:GetPassingSize() + " of " + tester:GetSize() + " passed."

        Iterator<Test> failures = tester:GetFailedTestsIterator()
        repeat while failures:HasNext()
            Test test = failures:Next()
            output "FAILED: " + test:GetName()
            if test:GetMessage() not= ""
                output "    " + test:GetMessage()
            end
        end
    end
end
